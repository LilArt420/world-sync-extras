	},
	[17920] = {
		Title = "The Identity of the Plague",
		IconName = "ico_ep.bmp",
		Description = { "At the town hall of Destroyed Geffen we talked about the plague with the clues from the Dark Whisper. <NAVI>[Jeon Cheosa]<INFO>ch1_gef_in,175,188,0,101,0</INFO></NAVI> begins to explain." },
