	[16801] = {
		Title = "Abyss Researcher",
		IconName = "ico_ep.bmp",
		Description = { "You have conducted extensive research on the Biosphere Depths Abyss." },
		Summary = ""
	},
	[16802] = {
		Title = "Transporting Small Luggage",
		IconName = "ico_ep.bmp",
		Description = { "You're responsible for returning luggage to its proper location at Alberta Port. Find Walter Fleetman in Alberta <NAVI>[near the market]<INFO>jor_albe.gat,148,235,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Walter Fleetman"
	},
	[16803] = {
		Title = "Transporting Small Luggage",
		IconName = "ico_ep.bmp",
		Description = { "You're responsible for returning the luggage at Alberta Port to its proper location. Find Walter Fleetman in Alberta Walter's <NAVI>[Upper Warehouse]<INFO>jalbe_in.gat,22,63,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Walter Fleetman"
	},
	[16804] = {
		Title = "Transporting Small Luggage",
		IconName = "ico_ep.bmp",
		Description = { "All of Alberta's luggage has been returned to its proper place. Return to <NAVI>[John]<INFO>jor_albe.gat,239,115,0,101,0</INFO></NAVI> at Alberta Beach and report your completion." },
		Summary = "Talk to John"
	},
	[16805] = {
		Title = "Refusing Chores",
		IconName = "ico_ep.bmp",
		Description = { "I complained to John in Alberta that I couldn't do such trivial things. He told me to get some rest, but is that okay? Should I talk to <NAVI>[John]<INFO>jor_albe.gat,239,115,0,101,0</INFO></NAVI> again?" },
		Summary = "Talk to John"
	},
	[16806] = {
		Title = "Thorough Port Cleaning",
		IconName = "ico_ep.bmp",
		Description = { "The dirt around the Port of Alberta needs to be cleaned. Keep your eyes peeled for <NAVI>[messy spots]<INFO>jor_albe.gat,151,210,0,101,0</INFO></NAVI>." },
		Summary = "Cleaning the Dirt"
	},
	[16807] = {
		Title = "Thorough Port Cleaning",
		IconName = "ico_ep.bmp",
		Description = { "The dirt around the Port of Alberta needs to be cleaned. Keep your eyes peeled for <NAVI>[messy spots]<INFO>jor_albe.gat,211,136,0,101,0</INFO></NAVI>." },
		Summary = "Cleaning the Dirt"
	},
	[16808] = {
		Title = "Thorough Port Cleaning",
		IconName = "ico_ep.bmp",
		Description = { "The dirt around the Port of Alberta needs to be cleaned. Keep your eyes peeled for <NAVI>[messy spots]<INFO>jor_albe.gat,167,139,0,101,0</INFO></NAVI>." },
		Summary = "Cleaning the Dirt"
	},
	[16809] = {
		Title = "Thorough Port Cleaning",
		IconName = "ico_ep.bmp",
		Description = { "The dirt around the Port of Alberta needs to be cleaned. Keep your eyes peeled for <NAVI>[messy spots]<INFO>jor_albe.gat,190,175,0,101,0</INFO></NAVI>." },
		Summary = "Cleaning the Dirt"
	},
	[16810] = {
		Title = "Thorough Port Cleaning",
		IconName = "ico_ep.bmp",
		Description = { "The area around Alberta Harbor now looks a bit cleaner. Return to <NAVI>[John]<INFO>jor_albe.gat,239,115,0,101,0</INFO></NAVI> at Alberta Beach and report the cleaning." },
		Summary = "Talk to John"
	},
	[16811] = {
		Title = "Visit Walter's Upper Building",
		IconName = "ico_ep.bmp",
		Description = { "The next task in Alberta appears to be found inside the Walter's Upper Building. Let's go to the <NAVI>[room opposite the warehouse]<INFO>jalbe_in.gat,67,95,0,101,0</INFO></NAVI> in the Upper Building." },
		Summary = "Talk with Iana Operta"
	},
	[16812] = {
		Title = "A Strange Letter",
		IconName = "ico_ep.bmp",
		Description = { "received an errand from Iana in the upper building of Walter to deliver letters to various parts of Alberta. Take the letters and visit <NAVI>[Pallieria Edel]<INFO>jalbe_in.gat,126,54,0,101,0</INFO></NAVI>." },
		Summary = "Talk with Pallieria Edel"
	},
	[16813] = {
		Title = "A Strange Letter",
		IconName = "ico_ep.bmp",
		Description = { "I received an errand from Iana in the upper building of Walter to deliver letters to various parts of Alberta. Take the letters and visit <NAVI>[Hunter Sanguin]<INFO>jalbe_in.gat,29,28,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Hunter Sanguin"
	},
	[16814] = {
		Title = "A Strange Letter",
		IconName = "ico_ep.bmp",
		Description = { "I've sent letters to two locations in Alberta and received responses. Return to <NAVI>[Iana Operta]<INFO>jalbe_in.gat,67,95,0,101,0</INFO></NAVI> in the upper building of Walter." },
		Summary = "Talk with Iana Operta"
	},
	[16815] = {
		Title = "News from Lunaforma",
		IconName = "ico_ep.bmp",
		Description = { "I've heard why you had to run errands in Alberta. It's time to return to Lunaforma, where you've been given a new mission and where the escapees from the cult have arrived. Let's go and hear <NAVI>[Ivan Wigner]<INFO>jor_mbase.gat,233,277,0,101,0</INFO></NAVI>'s story." },
		Summary = "Talk to Ivan Wigner"
	},
	[16816] = {
		Title = "Unidentified Ghost Ship",
		IconName = "ico_ep.bmp",
		Description = { "It seems we can finally uncover the identity of the mysterious ghost ship floating the sea. Join Maristella, who is waiting for you at Alberta <NAVI>[Port]<INFO>jor_albe.gat,191,186,0,101,0</INFO></NAVI>, and board the ghost ship." },
		Summary = "Talk to Maristella Walter"
	},
	[16817] = {
		Title = "The Ghost Ship's Identity",
		IconName = "ico_ep.bmp",
		Description = { "You've learned the identity of the drifting ghost ship. With the longing in your heart now buried, return to Alberta <NAVI>[Port]<INFO>jor_albe.gat,191,186,0,101,0</INFO></NAVI> with Maristella." },
		Summary = "Talk to Maristella Walter"
	},
	[16818] = {
		Title = "Return to Lunaforma",
		IconName = "ico_ep.bmp",
		Description = { "It seems we've pretty much finished what we can do in Alberta. Now, let's return to <NAVI>[Tris]<INFO>mbase_in.gat,92,123,0,101,0</INFO></NAVI> in Lunaforma." },
		Summary = "Talk to Tris"
	},
	[16819] = {
		Title = "Message from the Wizard",
		IconName = "ico_ep.bmp",
		Description = { "While talking to Maristella at Alberta Port, the <NAVI>[Wigner Merchant]<INFO>jor_albe.gat,192,189,0,101,0</INFO></NAVI> suddenly found himself waiting behind her." },
		Summary = "Talk with the Wigner Merchant"
	},
	[16820] = {
		Title = "Alberta's Honest Worker",
		IconName = "ico_ep.bmp",
		Description = { "Alberta's Epesto Walter Megas tells you to go to Alberta <NAVI>[Beach]<INFO>jor_albe.gat,239,115,0,101,0</INFO></NAVI> and look for work. Let's find someone who can give you work." },
		Summary = "Talk to John"
	},
	[16821] = {
		Title = "Remaining Questions",
		IconName = "ico_ep.bmp",
		Description = { "We've confirmed the last sighting of the old Walter, and it's said its magical power is still being detected. Let's try boarding it again with the help of <NAVI>[Nillem]<INFO>jor_albe.gat,195,179,0,101,0</INFO></NAVI>, who is staying in Alberta." },
		Summary = "Talk with Nillem"
	},
	[16822] = {
		Title = "Remaining Questions",
		IconName = "ico_ep.bmp",
		Description = { "Reboarding the Old Walter, the mystery remains. The captain's lost mind is also puzzling. Let's return to Alberta and speak with <NAVI>[Nillem]<INFO>jor_albe.gat,195,179,0,101,0</INFO></NAVI>." },
		Summary = "Talk with Nillem"
	},
	[16823] = {
		Title = "[Standby] Old Walter's Memory Fragment",
		IconName = "ico_dq.bmp",
		Description = { "Thanks to the adventurers and Maristella, there are currently no traces of the Old Walter. Let's take a short break until <NAVI>[Nillem]<INFO>jor_albe.gat,195,179,0,101,0</INFO></NAVI>, waiting in Alberta, can observe again." },
		Summary = "Reset at 04:00"
	},
	[16824] = {
		Title = "Old Walter's Memory Fragment",
		IconName = "ico_ep.bmp",
		Description = { "Let's scatter the Old Walter's Memory Fragment once more and return to <NAVI>[Nillem]<INFO>jor_albe.gat,195,179,0,101,0</INFO></NAVI>, who awaits us in Alberta." },
		Summary = "Exploring Old Walter's Memory Fragment"
	},
	[16825] = {
		Title = "Remaining Questions",
		IconName = "ico_ep.bmp",
		Description = { "Let's investigate the strangeness here and bring down the captain who lost his mind." },
		Summary = ""
	},
	[16826] = {
		Title = "Old Walter's Memory Fragment",
		IconName = "ico_ep.bmp",
		Description = { "Let's stop the ghost ship's captain and disperse the magic power trapped within this ship." },
		Summary = ""
	},
	[16912] = {
		Title = "Examining Patients in the Clinic",
		IconName = "ico_ep.bmp",
		Description = { "I decided to meet patients in person. Let's visit <NAVI>[a patient with a severe cough]<INFO>ch1_gef_in,109,37,0,101,0</INFO></NAVI> in the Neumann clinic in the Destroyed Geffen." },
		Summary = "Visiting a Patient with a Severe Cough"
	},
	[16913] = {
		Title = "Examining Patients in the Clinic",
		IconName = "ico_ep.bmp",
		Description = { "I decided to meet patients in person. Let's visit <NAVI>[Patients Who Want to Wash]<INFO>ch1_gef_in,102,33,0,101,0</INFO></NAVI> in the Neumann clinic in the Destroyed Geffen." },
		Summary = "Visiting Patients Who Want to Wash"
	},
	[16914] = {
		Title = "Examining Patients in the Clinic",
		IconName = "ico_ep.bmp",
		Description = { "I decided to meet patients in person. Let's visit <NAVI>[a patient who has lost weight]<INFO>ch1_gef_in,65,112,0,101,0</INFO></NAVI>." },
		Summary = "Visiting a Patient Who Has Lost Weight"
	},
	[16915] = {
		Title = "Examining Patients in the Clinic",
		IconName = "ico_ep.bmp",
		Description = { "I decided to meet patients in person. Let's visit <NAVI>[young patients]<INFO>ch1_gef_in,106,106,0,101,0</INFO></NAVI> in the Destroyed Geffen Neumann clinic." },
		Summary = "Visiting Young Patients"
	},
	[16916] = {
		Title = "Examining Patients in the Clinic",
		IconName = "ico_ep.bmp",
		Description = { "I decided to meet patients in person. Let's visit <NAVI>[elderly patient]<INFO>ch1_gef_in,105,104,0,101,0</INFO></NAVI> is worried about in the Destroyed Geffen Neumann clinic." },
		Summary = "Visiting Elderly Patients"
	},
	[16917] = {
		Title = "About Soren Syndrome",
		IconName = "ico_ep.bmp",
		Description = { "It seems we've gathered some information from the patients. Let's go to the Destroyed Geffen Neumann clinic and discuss it with <NAVI>[Einhar]<INFO>ch1_gef_in,75,58,0,101,0</INFO></NAVI> and Gregor." },
		Summary = "Talk with Einhar"
	},
	[16918] = {
		Title = "Warm Towel",
		IconName = "ico_ep.bmp",
		Description = { "Patients who need to wash often ask for at least a wet towel. Let's ask the <NAVI>[Clinic Volunteer]<INFO>ch1_gef_in,115,40,0,101,0</INFO></NAVI> at the Destroyed Geffen Neumann clinic." },
		Summary = "Talk to the Clinic Volunteer"
	},
	[16919] = {
		Title = "Warm Towel",
		IconName = "ico_ep.bmp",
		Description = { "At the Destroyed Geffen Neumann clinic, I received a warm towel from a clinic volunteer. Let's give it to <NAVI>[the patient who wants a wash]<INFO>ch1_gef_in,102,33,0,101,0</INFO></NAVI>." },
		Summary = "Talk to a Patient Who Wants a Wash"
	},
	[16920] = {
		Title = "Request for additional food",
		IconName = "ico_ep.bmp",
		Description = { "A patient who has lost a lot of weight is still hungry. At the Destroyed Geffen Neumann clinic, ask the <NAVI>[clinic food volunteer]<INFO>ch1_gef_in,113,102,0,101,0</INFO></NAVI> for food." },
		Summary = "Talk to the clinic food volunteer"
	},
	[16921] = {
		Title = "Additional Meals",
		IconName = "ico_ep.bmp",
		Description = { "The clinic's food service volunteer happily provided meals. Bring food to <NAVI>[a patient who has lost weight]<INFO>ch1_gef_in,66,112,0,101,0</INFO></NAVI> in the Destroyed Geffen Neumann's clinic." },
		Summary = "Talking to a patient who has lost weight"
	},
	[16922] = {
		Title = "Report the patient's symptoms",
		IconName = "ico_ep.bmp",
		Description = { "Apparently, this symptom is not a good thing.... Let's report changes in the patient's symptoms to <NAVI>[Dr. Neumann]<INFO>ch1_gef_in,81,74,0,101,0</INFO></NAVI> at the Destroyed Geffen Neumann clinic." },
		Summary = "Talk to Dr. Neumann"
	},
	[16923] = {
		Title = "Sweet snacks seen in dreams",
		IconName = "ico_ep.bmp",
		Description = { "For young patients, clinic meals are not suitable for young patients. At the Destroyed Geffen Neumann clinic, ask <NAVI>[Clinic Food Volunteer]<INFO>ch1_gef_in,113,102,0,101,0</INFO></NAVI> if he has anything sweet." },
		Summary = "Talk to the clinic food service volunteer"
	},
	[16924] = {
		Title = "sweet snack of reality",
		IconName = "ico_ep.bmp",
		Description = { "Let's give <NAVI>[the young patient]<INFO>ch1_gef_in,106,106,0,101,0</INFO></NAVI> the sweets that the clinic distribution volunteer did his best to make at the Destroyed Geffen Neumann clinic." },
		Summary = "Talking to a Young Patient"
	},
	[16925] = {
		Title = "Visit to a clergy clinic",
		IconName = "ico_ep.bmp",
		Description = { "We also visited a treatment center managed by priests from the Destroyed Geffen to investigate. Let's talk to <NAVI>[Gregor]<INFO>ch1_gef_in,29,174,0,101,0</INFO></NAVI>, who is talking to a patient who appears to be introverted." },
		Summary = "Talk to Gregor"
	},
	[16926] = {
		Title = "Visit to the Wizard's Infirmary",
		IconName = "ico_ep.bmp",
		Description = { "We also visited a treatment center managed by the fallen wizards of Geffen to investigate. Let's talk to <NAVI>[Einhar]<INFO>ch1_gef_in,70,170,0,101,0</INFO></NAVI>, who is talking to a patient who looks disapproving." },
		Summary = "Talk to Einhar"
	},
	[16927] = {
		Title = "Research clues",
		IconName = "ico_ep.bmp",
		Description = { "After exploring here and there, I returned to the village hall of Destroyed Geffen. <NAVI>[Gregor]<INFO>ch1_gef_in,179,193,0,101,0</INFO></NAVI> looks a little happy, saying that he can now demonstrate his specialty in his main job." },
		Summary = "Talk to Gregor"
	},
	[16928] = {
		Title = "Patient Blood Collection",
		IconName = "ico_ep.bmp",
		Description = { "If you are infected with Soren syndrome in the Destroyed Geffen and want to be treated at Dr. Neumann's clinic and obtain a blood sample from the patient, you will probably need permission from <NAVI>[Dr. Neumann]<INFO>ch1_gef_in,81,74,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Dr. Neumann"
	},
	[16929] = {
		Title = "Blood Collection from an Uninfected Person",
		IconName = "ico_ep.bmp",
		Description = { "To obtain a blood sample from a healthy person who has not been infected with Soren syndrome from the Destroyed Geffen, let's first go around the <NAVI>[streets]<INFO>ch1_geffen,180,147,0,101,0</INFO></NAVI>.... I have to be careful not to be misunderstood as spreading religion or selling something." },
		Summary = "Talk to Aire"
	},
	[16930] = {
		Title = "Blood Collection from the Recovered",
		IconName = "ico_ep.bmp",
		Description = { "I heard that <NAVI>[Dapan]<INFO>ch1_gef_in,75,143,0,101,0</INFO></NAVI>, who lives in the destroyed town of Geffen, suffered from Soren syndrome and recovered. Let's ask to collect a blood sample." },
		Summary = "Talk to Dapan"
	},
	[16931] = {
		Title = "Patient Blood Transfer",
		IconName = "ico_ep.bmp",
		Description = { "Blood samples were collected from patients in Neumann's clinic. Let's return to the <NAVI>[Town Hall]<INFO>ch1_gef_in.gat,182,191,0,101,0</INFO></NAVI> of Destroyed Geffen." },
		Summary = "Report at the Town Hall"
	},
	[16932] = {
		Title = "Blood Transfer from an Uninfected Person",
		IconName = "ico_ep.bmp",
		Description = { "Blood samples were taken from healthy people who were not infected with Soren syndrome. Let's return to the <NAVI>[Town Hall]<INFO>ch1_gef_in.gat,182,191,0,101,0</INFO></NAVI> of Destroyed Geffen." },
		Summary = "Report at the Town Hall"
	},
	[16933] = {
		Title = "Blood Transfer from the Recovered",
		IconName = "ico_ep.bmp",
		Description = { "Blood samples were taken from people who had recovered from Soren syndrome. Let's return to the <NAVI>[Town Hall]<INFO>ch1_gef_in.gat,182,191,0,101,0</INFO></NAVI> of Destroyed Geffen." },
		Summary = "Report at the Town Hall"
	},
	[16934] = {
		Title = "Conclusion of the Study",
		IconName = "ico_ep.bmp",
		Description = { "Several blood samples were collected and studied from the village hall of Destroyed Geffen. <NAVI>[Gregor]<INFO>ch1_gef_in,179,193,0,101,0</INFO></NAVI> seems to have figured something out." },
		Summary = "Talk to Gregor"
	},
	[16935] = {
		Title = "Patient Blood Collection",
		IconName = "ico_ep.bmp",
		Description = { "Permission was obtained to take blood samples from the Destroyed Geffen Neumann clinic. Go to <NAVI>[the patient in treatment]<INFO>ch1_gef_in,79,73,0,101,0</INFO></NAVI> and use the blood collection kit." },
		Summary = "Talk to the Patient in Treatment"
	},
	[16936] = {
		Title = "What Doctor Neumann Doesn't Know",
		IconName = "ico_ep.bmp",
		Description = { "We must inform Dr. Neumann of the research results as soon as possible. It would be a good idea to go to <NAVI>[Dr. Neumann's home]<INFO>ch1_geffen,176,66,0,101,0</INFO></NAVI> in the Destroyed Geffen." },
		Summary = "Visit to Neumann's home"
	},
	[16937] = {
		Title = "What Doctor Neumann is Hiding",
		IconName = "ico_ep.bmp",
		Description = { "What does that suspicious conversation mean? They broke into the home of Dr. Neumann in Destroyed Geffen. <NAVI>[Gregor]<INFO>ch1_gef_in,111,169,0,101,0</INFO></NAVI> seems to have discovered something." },
		Summary = "Talk to Gregor"
	},
	[16938] = {
		Title = "What else is Dr. Neumann hiding?",
		IconName = "ico_ep.bmp",
		Description = { "It feels even more strange.... Inside the home of Dr. Neumann in Destroyed Geffen, <NAVI>[Einhar]<INFO>ch1_gef_in,144,171,0,101,0</INFO></NAVI> seems to have become accustomed to home invasions." },
		Summary = "Talk to Einhar"
	},
	[16939] = {
		Title = "Go to the clinic",
		IconName = "ico_ep.bmp",
		Description = { "Einhar says he will return to Ash Village with what he found at Dr. Neumann's house. Let's go back to <NAVI>[clinic]<INFO>ch1_geffen,167,173,0,101,0</INFO></NAVI> of Geffen, which collapsed with Gregor." },
		Summary = "Talk to Jeon Cheosa"
	},
	[16940] = {
		Title = "An open door that was always locked",
		IconName = "ico_ep.bmp",
		Description = { "There is a door in Dr. Neumann's clinic in Destroyed Geffen that was always locked. I see the door slightly open.... It's somehow strange.Let's go in and take a look at <NAVI>[inside]<INFO>ch1_gef_in,26,70,0,101,0</INFO></NAVI>." },
		Summary = "Check inside the clinic door at 9 o'clock"
	},
	[16941] = {
		Title = "Eavesdropping Techniques",
		IconName = "ico_ep.bmp",
		Description = { "In Dr. Neumann's clinic in Destroyed Geffen, sounds of fighting are heard from inside the always locked door. Let's go down the <NAVI>[staircase]<INFO>ch1_gef_in,26,34,0,101,0</INFO></NAVI> and eavesdrop carefully." },
		Summary = "Hiding on the Staircase"
	},
	[16942] = {
		Title = "Urgent Rescue",
		IconName = "ico_ep.bmp",
		Description = { "Something strange is happening in the basement of Dr. Neumann's clinic in Destroyed Geffen. We have to quickly chase after the two men <NAVI>[through the door]<INFO>ch1_gef_in,29,22,0,101,0</INFO></NAVI>." },
		Summary = "Enter inside the door"
	},
	[16943] = {
		Title = "Urgent Rescue",
		IconName = "ico_ep.bmp",
		Description = { "Einhar opened a <NAVI>[portal]<INFO>ch1_gef_in,29,29,0,101,0</INFO></NAVI>, which leads back to Ash Village, in the basement of Dr. Neumann's clinic in the Destroyed Geffen. Let's go back to Ash Village." },
		Summary = "Use the portal"
	},
	[16944] = {
		Title = "Urgent Rescue",
		IconName = "ico_ep.bmp",
		Description = { "Einhar recommended calming down and tracking down with his colleagues. Let's go back to Ash Village and find the <NAVI>[Jeon Cheosa]<INFO>ygg_fruit,40,72,0,101,0</INFO></NAVI> and Gregor." },
		Summary = "Talk to Jeon Cheosa"
	},
	[16945] = {
		Title = "Urgent Rescue",
		IconName = "ico_ep.bmp",
		Description = { "Jeon Cheosa, Gregor, and I returned to the destroyed basement of Geffen's Dr. Neumann's clinic. Now is the time to head to the real <NAVI>[clinic basement]<INFO>ch1_gef_in,29,22,0,101,0</INFO></NAVI>." },
		Summary = "Enter the portal"
	},
	[16946] = {
		Title = "Uneasy Traces",
		IconName = "ico_ep.bmp",
		Description = { "An unexpected scene unfolds in the basement of Dr. Neumann's clinic in Destroyed Geffen. <NAVI>[Gregor]<INFO>ch1_que01,141,114,0,101,0</INFO></NAVI> seems to have found some traces left by Einhar." },
		Summary = "Talk to Gregor"
	},
	[16947] = {
		Title = "Ominous Signs",
		IconName = "ico_ep.bmp",
		Description = { "The basement of Dr. Neumann's clinic in Destroyed Geffen was full of monsters. Meanwhile, the <NAVI>[Jeon Cheosa]<INFO>ch1_que01,126,57,0,101,0</INFO></NAVI> felt a new presence." },
		Summary = "Talk to Jeon Cheosa"
	},
	[16948] = {
		Title = "Uneasy Traces",
		IconName = "ico_ep.bmp",
		Description = { "Everyone wandering around the basement of Dr. Neumann's clinic in Destroyed Geffen became increasingly impatient. The <NAVI>[Jeon Cheosa]<INFO>ch1_que01,51,46,0,101,0</INFO></NAVI> calmly found traces of Einhar." },
		Summary = "Talk to Jeon Cheosa"
	},
	[16949] = {
		Title = "What was at the end of the trail?",
		IconName = "ico_ep.bmp",
		Description = { "In the basement of Dr. Neumann's clinic in Destroyed Geffen, we finally find <NAVI>[Einhar]<INFO>ch1_que01,67,128,0,101,0</INFO></NAVI> who was tracking people, but he looks devastated." },
		Summary = "Talk to Einhar"
	},
	[16950] = {
		Title = "Finding a better solution",
		IconName = "ico_ep.bmp",
		Description = { "I found what I was looking for in this basement.Let's go back to Dr. Neumann's clinic in Destroyed Geffen and tell <NAVI>[Maxim]<INFO>ch1_gef_in,69,33,0,101,0</INFO></NAVI> what we saw down here." },
		Summary = "Talk to Maxim"
	},
	[16951] = {
		Title = "To Ash Village",
		IconName = "ico_ep.bmp",
		Description = { "I may have found a clue in the diary I left behind. Let's go back to <NAVI>[Professor Telkos]<INFO>ygg_edge,209,209,0,101,0</INFO></NAVI> in Ash Village and check the progress." },
		Summary = "Talk to Professor Telkos"
	},
	[17690] = {
		Title = "A New Exploration Site",
		IconName = "ico_ep.bmp",
		Description = { "Gather at the inner part of <NAVI>[Ice Castle]<INFO>icas_in,262,202,0,101,0</INFO></NAVI> to discuss a new exploration site." },
		Summary = "To the Ice Castle"
	},
	[17691] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "The previously sealed door of <NAVI>[Lair of the Serpent]<INFO>jor_nest,36,274,0,101,0</INFO></NAVI> has been opened. Now, it's just a matter of entering while transformed into Rgan using a transformation scroll." },
		Summary = "The Door Is Open"
	},
	[17692] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "After transforming into Rgan using a transformation scroll, entered the opened Lair of the Serpent's <NAVI>[Beyond]<INFO>jor_root1,32,34,0,101,0</INFO></NAVI>. Let's investigate thoroughly." },
		Summary = "To the Roots of the Serpent"
	},
	[17693] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "Identified some unusual Rgan who appear human. First, let's deal with these creatures and then search for the <NAVI>[Companions]<INFO>jor_root2,239,243,0,101,0</INFO></NAVI> in the roots of the serpent." },
		Summary = "Defeat 5 Superior Rgan Warlocks"
	},
	[17694] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "Lazy went ahead to explore the interior. Let's wait for Lazy in the <NAVI>[Sanctuary]<INFO>jor_root2,239,243,0,101,0</INFO></NAVI> within the roots of the serpent." },
		Summary = "Aiding Lazy the Resolver"
	},
	[17695] = {
		Title = "Infiltrating the Lair of Rgan",
		IconName = "ico_ep.bmp",
		Description = { "Lazy suggested disguising as Rgan bishops and infiltrating the <NAVI>[Sanctuary]<INFO>jor_root2,239,243,0,101,0</INFO></NAVI> within the roots of the serpent. Is this Lazy's plan?" },
		Summary = "Lazy's Stratagem?"
	},
	[17696] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "The party decided to use the appearance of Lazy, disguised as a top-tier Rgan, to enter the <NAVI>[Sacred Roots]<INFO>jor_sanct,162,86,0,101,0</INFO></NAVI>." },
		Summary = "To the Sacred Roots"
	},
	[17697] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "When arriving at the Sacred Roots, top-tier <NAVI>[Rgan]<INFO>jor_sanct,162,86,0,101,0</INFO></NAVI> individuals stood in line, seeking assistance. Let's help them wholeheartedly." },
		Summary = "Assisting Rgan's Tasks 1"
	},
	[17698] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "Go out to <NAVI>[Lair of the Serpent]<INFO>jor_root2,26,271,0,101,0</INFO></NAVI> and gather three snakeberries, which our <NAVI>[Bishops]<INFO>jor_sanct,162,86,0,101,0</INFO></NAVI> enjoy." },
		Summary = "Collect 3 Snakeberries"
	},
	[17699] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "We obtained some information about the Sacred Roots from the top-tier Rgan. Let's get more information from other top-tier <NAVI>[Rgan]<INFO>jor_sanct,185,128,0,101,0</INFO></NAVI> individuals in the Sacred Roots." },
		Summary = "Assisting Rgan's Tasks 2"
	},
	[17700] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "We learned about the Magic Absorption Device and the Iwin Transformation Device from a top-tier Rgan. Let's seek more information from other top-tier <NAVI>[Rgan]<INFO>jor_sanct,42,105,0,101,0</INFO></NAVI> individuals in the Sacred Roots." },
		Summary = "Assisting Rgan's Tasks 3"
	},
	[17701] = {
		Title = "Earning Rgan's Trust",
		IconName = "ico_ep.bmp",
		Description = { "To acquire more information, we need to gain Rgan's trust. Let's assist Rgan individuals in need, including <NAVI>[Pamoshugand]<INFO>jor_sanct,257,115,0,101,0</INFO></NAVI>, at the Sacred Roots." },
		Summary = "Assisting Rgan's Tasks 4"
	},
	[17702] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "Sarekgand, known as Rasgand's right hand, will quietly approach adventurers in front of the <NAVI>[Door]<INFO>jor_sanct,22,283,0,101,0</INFO></NAVI> leading to the Serpent's Maze." },
		Summary = "To the Serpent's Maze"
	},
	[17703] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "There are parasites living in the Serpent's Maze beyond this door. It seems like some cleaning is needed. Before that person arrives, deal with three of them and return to <NAVI>[Sacred Roots]<INFO>jor_sanct,22,283,0,101,0</INFO></NAVI>." },
		Summary = "Defeat 3 parasites in the Serpent's Maze"
	},
	[17704] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "Sarekgand, known as Rasgand's right hand, said he is going to meet Rasgand. Let's investigate Sarekgand's <NAVI>[Traces]<INFO>jor_maze,15,47,0,101,0</INFO></NAVI> within the Serpent's Maze." },
		Summary = "Finding Sarekgand's Traces 1"
	},
	[17705] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "Sarekgand's traces are sporadically present. It seems like a more thorough search of <NAVI>[Serpent's Maze]<INFO>jor_maze,17,153,0,101,0</INFO></NAVI> is necessary." },
		Summary = "Finding Sarekgand's Traces 2"
	},
	[17706] = {
		Title = "Heading Towards the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "After parting ways with the party, you are left alone. Investigate <NAVI>[Serpent's Maze]<INFO>jor_maze,140,71,0,101,0</INFO></NAVI> for Sarekgand's traces." },
		Summary = "Finding Sarekgand's Traces 3"
	},
	[17707] = {
		Title = "Unexpected Reunion",
		IconName = "ico_ep.bmp",
		Description = { "There is a suspicious <NAVI>[Device]<INFO>jor_maze,140,71,0,101,0</INFO></NAVI> in the Serpent's Maze. The only person who could have created such a device is Bagot. Investigating the device may provide clues." },
		Summary = "Investigating the Suspicious Device"
	},
	[17708] = {
		Title = "Unexpected Reunion",
		IconName = "ico_ep.bmp",
		Description = { "During a confrontation with Rasgand, a white cat suddenly appeared and sent Rasgand's group flying, including the adventurer <NAVI>[Party]<INFO>jor_back1,365,226,0,101,0</INFO></NAVI>, to the frozen Scaled Hill." },
		Summary = "The Power of the White Cat"
	},
	[17709] = {
		Title = "Report on Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "Return to <NAVI>[Ice Castle]<INFO>icas_in,226,255,0,101,0</INFO></NAVI> and report the information about 'that place' and Rasgand." },
		Summary = "To the Ice Castle"
	},
	[17710] = {
		Title = "Cleaning the Serpent's Maze",
		IconName = "ico_ep.bmp",
		Description = { "It's all about cleaning today! Eliminate 10 Jormungandr Guardians of each color in the Serpent's Maze and then return to <NAVI>[Sacred Roots]<INFO>jor_sanct,22,283,0,101,0</INFO></NAVI>." },
		Summary = "Dealing with Jormungandr Guardians"
	},
	[17711] = {
		Title = "[Standby] Cleaning the Serpent's Maze",
		IconName = "ico_dq.bmp",
		Description = { "After the dawn passes, go to the <NAVI>[Supervisor]<INFO>jor_sanct,22,283,0,101,0</INFO></NAVI> in the Sacred Roots to receive new cleaning tasks." },
		Summary = "4 AM Reset"
	},
	[17712] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "It's said that the top-tier Rgan we captured earlier is causing trouble. Let's go to the Ice Castle following <NAVI>[Iwin Soldier]<INFO>icecastle,46,164,0,101,0</INFO></NAVI> asking for help." },
		Summary = "To the Ice Castle"
	},
	[17713] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Horuru]<INFO>icas_in2,31,116,0,101,0</INFO></NAVI> is in a dilemma because of Nadyagand's demands for keeping him imprisoned in the Ice Castle." },
		Summary = "Distinguished Guest"
	},
	[17714] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "To make Nadyagand, who is imprisoned in the Ice Castle, talk, we need to bring the snakeberries he demands. Let's go to <NAVI>[Snake God's Roots]<INFO>jor_root2,25,21,0,101,0</INFO></NAVI> and gather 10 snakeberries." },
		Summary = "Collect 10 Snakeberries"
	},
	[17715] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "We've obtained the snakeberries, but the top-tier Rgan knows nothing. Just when he was about to give in to the idea of sitting in the Ice Castle, <NAVI>[Lazy]<INFO>icas_in2,32,120,0,101,0</INFO></NAVI> appeared. Let's seek advice from Lazy." },
		Summary = "Conversation with Lazy"
	},
	[17716] = {
		Title = "A New Beginning",
		IconName = "ico_ep.bmp",
		Description = { "Lazy easily persuaded Nadyagand to work without any intentions of playing or eating. How? Let's ask <NAVI>[Lazy]<INFO>icas_in2,32,120,0,101,0</INFO></NAVI> for the details when visiting the Ice Castle." },
		Summary = "Conversation with Lazy"
	},
	[17717] = {
		Title = "[Standby] Taste of Leisure",
		IconName = "ico_dq.bmp",
		Description = { "Unintentionally, we've decided to bring some snacks to <NAVI>[Nadyagand]<INFO>icas_in2,30,121,0,101,0</INFO></NAVI> who is working hard. Let's return to the Ice Castle after dawn." },
		Summary = "4 AM Reset"
	},
	[17718] = {
		Title = "Taste of Leisure",
		IconName = "ico_ep.bmp",
		Description = { "Let's gather 10 snakeberries from <NAVI>[Snake God's Roots]<INFO>jor_root2,25,21,0,101,0</INFO></NAVI> for <NAVI>[Nadyagand]<INFO>icas_in2,30,121,0,101,0</INFO></NAVI>, who is working diligently in the Ice Castle." },
		Summary = "Collect 10 Snakeberries"
	},
	[17719] = {
		Title = "Sacred and Divine",
		IconName = "ico_ep.bmp",
		Description = { "Deliver snakeberries to the Rgan <NAVI>[Bishop]<INFO>jor_sanct,162,86,0,101,0</INFO></NAVI> in the Sacred Roots." },
		Summary = "Deliver Snakeberries"
	},
	[17752] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Time to act inside <NAVI>[Gimle]<INFO>jor_tmple1,186,72,0,101,0</INFO></NAVI>, the temple of the Jormungandr cult." },
		Summary = "Enter the temple"
	},
	[17753] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Find out whether anyone in <NAVI>[Gimle]<INFO>jor_tmple1,110,190,0,101,0</INFO></NAVI> wants to escape." },
		Summary = "Search the temple 1"
	},
	[17754] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Look for information about the ghost ship in <NAVI>[Gimle]<INFO>jor_tmple1,186,228,0,101,0</INFO></NAVI>." },
		Summary = "Search the temple 2"
	},
	[17755] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Maybe the 2nd floor of <NAVI>[Gimle]<INFO>jor_tmple1,238,268,0,101,0</INFO></NAVI> holds better information?" },
		Summary = "Search the temple 3"
	},
	[17756] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Nothing useful. Meet the others at the meeting point in <NAVI>[Gimle]<INFO>jor_tmple1,188,72,0,101,0</INFO></NAVI>." },
		Summary = "Join the others"
	},
	[17757] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Nobody found anything. Go back to <NAVI>[Lunaforma]<INFO>jor_mbase,143,272,0,101,0</INFO></NAVI> and think of something else." },
		Summary = "To Lunaforma"
	},
	[17758] = {
		Title = "Recruiting for Success",
		IconName = "ico_ep.bmp",
		Description = { "Meet Nadoyo at the meeting place on <NAVI>[Scale Island]<INFO>jor_crk_p,71,85,0,101,0</INFO></NAVI>: Nadoyo knows the inside of the temple." },
		Summary = "To the meeting place"
	},
	[17759] = {
		Title = "Recruiting for Success",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Ivan]<INFO>jor_crk_p,69,85,0,101,0</INFO></NAVI> has a proposal for those left on Scale Island..." },
		Summary = "Talk to Ivan"
	},
	[17760] = {
		Title = "Recruiting for Success",
		IconName = "ico_ep.bmp",
		Description = { "The talent Ivan talked about works at the canteen of <NAVI>[Lunaforma]<INFO>jor_mbase,166,302,0,101,0</INFO></NAVI>. Can you win him over?" },
		Summary = "To Lunaforma"
	},
	[17761] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "Join Nadoyo in the north of the <NAVI>[Raised Land]<INFO>jor_raise1,323,71,0,101,0</INFO></NAVI> and hear how to get into the temple." },
		Summary = "To the Raised Land"
	},
	[17762] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "Meet Nadoyo, waiting in <NAVI>[Gimle]<INFO>jor_tmple1,238,268,0,101,0</INFO></NAVI>, and learn what to watch out for inside the cult. You can't fail twice." },
		Summary = "To the temple's 2nd floor"
	},
	[17763] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "The guard of <NAVI>[Gimle]<INFO>jor_tmple1,238,268,0,101,0</INFO></NAVI> needs a moment to check the register." },
		Summary = "Register with the guard"
	},
	[17764] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "Karmilgand, a high priest, is locked up somewhere in <NAVI>[Gimle]<INFO>jor_tmple1,238,268,0,101,0</INFO></NAVI>. Help him escape." },
		Summary = "Rescue Karmilgand"
	},
	[17765] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "You barely got Karmilgand out. Join the others in the north of the <NAVI>[Raised Land]<INFO>jor_raise1,323,71,0,101,0</INFO></NAVI>." },
		Summary = "To the Raised Land"
	},
	[17766] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "The rescue worked. Take Karmilgand and the believers back to <NAVI>[Lunaforma]<INFO>jor_mbase,143,272,0,101,0</INFO></NAVI>." },
		Summary = "To Lunaforma"
	},
	[17767] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "An open square is no place for this talk. Go somewhere quiet in <NAVI>[Lunaforma]<INFO>mbase_in,116,186,0,101,0</INFO></NAVI>." },
		Summary = "Somewhere quiet"
	},
	[17768] = {
		Title = "Second Infiltration",
		IconName = "ico_ep.bmp",
		Description = { "In the central barracks of <NAVI>[Lunaforma]<INFO>mbase_in,118,186,0,101,0</INFO></NAVI> everyone is talking about Reinhardt. He says he knows about the ghost ship." },
		Summary = "Talk to Reinhardt"
	},
	[17769] = {
		Title = "Report on the Ghost Ship",
		IconName = "ico_ep.bmp",
		Description = { "You have news of the ghost ship. Report to <NAVI>[Maristella]<INFO>jalbe_in,68,46,0,101,0</INFO></NAVI> in Alberta." },
		Summary = "To Maristella"
	},
	[17770] = {
		Title = "The Roegenburg Brothers",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Reinhardt]<INFO>mbase_in,118,186,0,101,0</INFO></NAVI>, staying in the central barracks, has a lot to say to his brother." },
		Summary = "Talk to Reinhardt"
	},
	[17771] = {
		Title = "The Roegenburg Brothers",
		IconName = "ico_ep.bmp",
		Description = { "Take Reinhardt's idea to <NAVI>[Tris]<INFO>jor_mbase,140,201,0,101,0</INFO></NAVI>, who leads Lunaforma." },
		Summary = "To Tris"
	},
	[17772] = {
		Title = "The Roegenburg Brothers",
		IconName = "ico_ep.bmp",
		Description = { "Tris will come to see <NAVI>[Reinhardt]<INFO>mbase_in,118,186,0,101,0</INFO></NAVI> soon. Go back to the central barracks first." },
		Summary = "To Reinhardt"
	},
	[17773] = {
		Title = "The Roegenburg Brothers",
		IconName = "ico_ep.bmp",
		Description = { "Tris suggests going with Reinhardt to see Wilhelm at the <NAVI>[canteen]<INFO>jor_mbase,197,277,0,101,0</INFO></NAVI>." },
		Summary = "To the canteen"
	},
	[17774] = {
		Title = "The Roegenburg Brothers",
		IconName = "ico_ep.bmp",
		Description = { "Believers crowd around <NAVI>[Reinhardt]<INFO>jor_mbase,194,279,0,101,0</INFO></NAVI> at the canteen. What is going on?" },
		Summary = "Talk to Reinhardt"
	},
	[17775] = {
		Title = "The Roegenburg Brothers",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Wilhelm]<INFO>jor_mbase,196,280,0,101,0</INFO></NAVI>, working at the canteen, comes over with a worried face." },
		Summary = "Talk to Wilhelm"
	},
	[17776] = {
		Title = "The Roegenburg Brothers",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Tris]<INFO>jor_mbase,197,277,0,101,0</INFO></NAVI> is delighted to see the brothers talking. Ask Tris if there is more to do in Lunaforma." },
		Summary = "Talk to Tris"
	},
	[17777] = {
		Title = "A Safe Way Out 1",
		IconName = "ico_ep.bmp",
		Description = { "Defeat 300 monsters of any kind in the north of the Raised Land and report to <NAVI>[Tris]<INFO>jor_mbase,140,201,0,101,0</INFO></NAVI>." },
		Summary = "North of the Raised Land"
	},
	[17778] = {
		Title = "A Safe Way Out 2",
		IconName = "ico_ep.bmp",
		Description = { "Defeat 300 monsters of any kind in the south of the Raised Land and report to <NAVI>[Tris]<INFO>jor_mbase,140,201,0,101,0</INFO></NAVI>." },
		Summary = "South of the Raised Land"
	},
	[17779] = {
		Title = "[Standby] A Safe Way Out",
		IconName = "ico_dq.bmp",
		Description = { "Well done. Rest, and come back to <NAVI>[Tris]<INFO>jor_mbase,140,201,0,101,0</INFO></NAVI> after dawn." },
		Summary = "Reset at 04:00"
	},
	[17780] = {
		Title = "[Standby] A Safe Way Out",
		IconName = "ico_dq.bmp",
