	[17891] = {
		Title = "Geffen of the Parallel World",
		IconName = "ico_ep.bmp",
		Description = { "Feeling something strange from the direction of Geffen, Jeon Cheosa and I decided to go to the Geffen field of the broken dimension and join the rest of the <NAVI>[party]<INFO>hem_fild,102,161,0,101,0</INFO></NAVI>." },
		Summary = "To the destroyed Geffen field"
	},
	[17892] = {
		Title = "Geffen of the Parallel World",
		IconName = "ico_ep.bmp",
		Description = { "The party decided to go to <NAVI>[Destroyed Geffen]<INFO>ch1_geffen,190,123,0,101,0</INFO></NAVI>, which needs help. What will we find there..." },
		Summary = "To Destroyed Geffen"
	},
	[17893] = {
		Title = "Geffen of the Parallel World",
		IconName = "ico_ep.bmp",
		Description = { "Arriving in Destroyed Geffen, we heard people worrying about a sickness. Let's hear more from the <NAVI>[residents]<INFO>ch1_geffen,190,123,0,101,0</INFO></NAVI>." },
		Summary = "Talk about the sickness"
	},
	[17894] = {
		Title = "Geffen of the Parallel World",
		IconName = "ico_ep.bmp",
		Description = { "A worse sickness than we thought seems to be spreading in Destroyed Geffen. Let's ask other <NAVI>[people]<INFO>ch1_geffen,149,55,0,101,0</INFO></NAVI> for more." },
		Summary = "Hear more"
	},
	[17895] = {
		Title = "Geffen of the Parallel World",
		IconName = "ico_ep.bmp",
		Description = { "A resident of Destroyed Geffen said the wizards of the Geffen Tower may be the cause of this sickness. We'd better investigate the <NAVI>[Geffen Tower]<INFO>ch1_geffen,120,115,0,101,0</INFO></NAVI>." },
		Summary = "To the Geffen Tower"
	},
	[17896] = {
		Title = "Geffen of the Parallel World",
		IconName = "ico_ep.bmp",
		Description = { "At the Geffen Tower of Destroyed Geffen, a stranger blocking our way introduced himself as the tower's <NAVI>[wizard]<INFO>ch1_geffen,122,118,0,101,0</INFO></NAVI>. Let's ask what happened." },
		Summary = "Talk to the wizard"
	},
	[17897] = {
		Title = "Geffen of the Parallel World",
		IconName = "ico_ep.bmp",
		Description = { "The way down under the Geffen Tower is sealed by a barrier. Ask <NAVI>[Jeon Cheosa]<INFO>ch1_geffen,117,117,0,101,0</INFO></NAVI> whether it can be lifted safely." },
		Summary = "Jeon Cheosa?"
	},
	[17898] = {
		Title = "Geffen of the Parallel World",
		IconName = "ico_ep.bmp",
		Description = { "While Jeon Cheosa, Charles and Clover look for a way to lift the tower's barrier, I'll go to the <NAVI>[clinic]<INFO>ch1_gef_in,70,64,0,101,0</INFO></NAVI> of Destroyed Geffen to look into the plague." },
		Summary = "To the clinic"
	},
	[17899] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "Jeon Cheosa found a safe way to lift the barrier sealing the underground of Destroyed Geffen, and wants to go to the <NAVI>[Geffen Tower]<INFO>ch1_geffen,122,118,0,101,0</INFO></NAVI> together." },
		Summary = "To the Geffen Tower"
	},
	[17900] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "Through the lifted barrier of the fallen Geffen Tower, we decided to go <NAVI>[underground]<INFO>hem_dun01,25,116,0,101,0</INFO></NAVI>. What will we find there?" },
		Summary = "Explore under the tower"
	},
	[17901] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "Below lay the destroyed Verus of the parallel world. While exploring Verus, we'll look for <NAVI>[Clover]<INFO>hem_dun01,85,139,0,101,0</INFO></NAVI>'s master and senior." },
		Summary = "Explore Verus"
	},
	[17902] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "We found Clover's master and senior safe in destroyed Verus, but the master seems strange. Let's hear what happened from her senior, <NAVI>[Sua]<INFO>hem_dun01,85,139,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Sua"
	},
	[17903] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "Sua says there is a truly dangerous being threatening the survivors in destroyed Verus. But her master, <NAVI>[Parzival]<INFO>hem_dun01,85,139,0,101,0</INFO></NAVI>, seems to think otherwise..." },
		Summary = "Talk to Parzival"
	},
	[17904] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "Saying he will show us a new world, Master Parzival takes the party <NAVI>[somewhere]<INFO>hem_dun01,182,199,0,101,0</INFO></NAVI> in destroyed Verus." },
		Summary = "To see the new world"
	},
	[17905] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "Clover's master led us here. A <NAVI>[group of believers]<INFO>hem_dun01,182,199,0,101,0</INFO></NAVI> waits for the moment of rebirth." },
		Summary = "The place of rebirth"
	},
	[17906] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "In a corner of destroyed Verus, someone has collapsed from the plague. Let's watch the rebirth of the new humanity more closely with the <NAVI>[people]<INFO>hem_dun01,182,199,0,101,0</INFO></NAVI>." },
		Summary = "The moment of rebirth"
	},
	[17907] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "Having seen the truth of the rebirth in destroyed Verus, the <NAVI>[party]<INFO>hem_dun01,182,199,0,101,0</INFO></NAVI> is horrified, and quickly talks it over." },
		Summary = "Talk to Jeon Cheosa"
	},
	[17908] = {
		Title = "Between Civilization and Barbarism",
		IconName = "ico_ep.bmp",
		Description = { "Having seen someone who died of the plague turn into the Immortal Legion, the party decides to follow the <NAVI>[Immortal Legion]<INFO>hem_dun01,221,209,0,101,0</INFO></NAVI>." },
		Summary = "Where the Immortal Legion went"
	},
	[17909] = {
		Title = "The Sky Fortress Dark Whisper",
		IconName = "ico_ep.bmp",
		Description = { "Following the Immortal Legion through destroyed Verus, the party comes upon the sky fortress <NAVI>[Dark Whisper]<INFO>ch1_dw,260,295,0,101,0</INFO></NAVI>. We decide to go in." },
		Summary = "Enter the Dark Whisper"
	},
	[17910] = {
