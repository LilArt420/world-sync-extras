		Summary = "Intermediate Rgan Job Search"
	},
	[8852] = {
		Title = "[Standby] I've come this far",
		IconName = "ico_dq.bmp",
		Description = { "This quest is a daily quest, and you can receive it again from <NAVI>[Nalsioramigand]<INFO>jor_sanct,271,156,0,101,0</INFO></NAVI> when the waiting time expires." },
		Summary = "Reset at 04:00"
	},
	[8853] = {
		Title = "I've come this far",
		IconName = "ico_ep.bmp",
		Description = { "Work is not assigned to intermediate Rgans who have followed their Sacred Roots. You have to give each one a task to do." },
		Summary = "Intermediate Rgan Job Search"
	},
	[8854] = {
		Title = "I probably have a lunch box",
		IconName = "ico_ep.bmp",
		Description = { "Did <NAVI>[Eririgand]<INFO>jor_sanct,101,138,0,101,0</INFO></NAVI> really tell this story to everyone?" },
		Summary = "Talk to Eririgand"
	},
	[8882] = {
		Title = "Ivan Wigner's Pleasant Missionary Life",
		IconName = "ico_ep.bmp",
		Description = { "I was planning to speak with Ivan Wigner at Lunaforma, but both he and Lehar are busy. Let's help <NAVI>[Lehar]<INFO>jor_mbase,214,316,0,101,0</INFO></NAVI> prepare the food." },
		Summary = "Talk with Lehar"
	},
	[8883] = {
		Title = "Lehar's Rewarding Relief Work (1)",
		IconName = "ico_ep.bmp",
		Description = { "Lunaforma's shelter has been expanded to provide meals using available ingredients, and it turns out that <NAVI>[Lehar]<INFO>jor_mbase,214,316,0,101,0</INFO></NAVI> possesses a hidden talent for perfectly cooking cauldron rice!" },
		Summary = "Talk with Lehar"
	},
	[8884] = {
		Title = "Lehar's Rewarding Relief Work (2)",
		IconName = "ico_ep.bmp",
		Description = { "Thankfully, the Lunaforma shelter is operating smoothly without any major issues. After the meal distribution, I decided to have a meal with <NAVI>[Lehar]<INFO>jor_mbase,214,316,0,101,0</INFO></NAVI>." },
		Summary = "Talk with Lehar"
	},
	[8885] = {
		Title = "He's robbing the whole house!",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Lehar]<INFO>jor_mbase,214,316,0,101,0</INFO></NAVI> heard that Ivan had poured a considerable amount of money from the Wigner Group into building a shelter in Lunaforma." },
		Summary = "Talk with Lehar"
	},
	[8886] = {
		Title = "Lehar's Rewarding Relief Work (3)",
		IconName = "ico_ep.bmp",
		Description = { "The food distribution at the Lunaforma shelter is complete. Now, let's take a breather and have a meal with <NAVI>[Ivan]<INFO>jor_mbase,189,282,0,101,0</INFO></NAVI> and Lehar." },
		Summary = "Talk with Ivan"
	},
	[8887] = {
		Title = "People who saw the ghost ship (1)",
		IconName = "ico_ep.bmp",
		Description = { "Talk to <NAVI>[Lyric]<INFO>jor_mbase,185,311,0,101,0</INFO></NAVI> in Lunaforma.." },
		Summary = "Talk with Lyric"
	},
	[8888] = {
		Title = "People who saw the ghost ship (2)",
		IconName = "ico_ep.bmp",
		Description = { "Talk to <NAVI>[Lyric]<INFO>jor_mbase,185,311,0,101,0</INFO></NAVI> in Lunaforma." },
		Summary = "Talk with Lyric"
	},
	[8889] = {
		Title = "Ivan's Scheme",
		IconName = "ico_ep.bmp",
		Description = { "Lyric's story wasn't helpful, but it confirmed the existence of the ghost ship. Let's hear <NAVI>[Ivan]<INFO>jor_mbase,233,277,0,101,0</INFO></NAVI>'s story." },
		Summary = "Talk with Ivan"
	},
	[8890] = {
		Title = "Ivan's Errand",
		IconName = "ico_ep.bmp",
		Description = { "Meet <NAVI>[Lalaira Wigner]<INFO>jalbe_in,56,138,0,101,0</INFO></NAVI> at the top of Wigner in Alberta." },
		Summary = "Talk to Lalaira Wigner"
	},
	[8891] = {
		Title = "Ivan's Old Folly",
		IconName = "ico_ep.bmp",
		Description = { "At the top of Alberta's Wigner, Lalaira told Ivan <NAVI>[where]<INFO>jalbe_in,73,187,0,101,0</INFO></NAVI> the item he had requested was." },
		Summary = "Finding the Chest"
	},
	[8892] = {
		Title = "With the Unclaimed Weapon",
		IconName = "ico_ep.bmp",
		Description = { "Then, it's time to return the weapon to its rightful owner. Return to Lunaforma and speak with <NAVI>[Ivan]<INFO>jor_mbase,233,277,0,101,0</INFO></NAVI>." },
		Summary = "Talk with Ivan"
	},
	[8893] = {
		Title = "Infiltrating the Cult",
		IconName = "ico_ep.bmp",
		Description = { "Now, let's regroup and head north to the Rising Lands. It's time to <NAVI>[infiltrate]<INFO>jor_raise1,323,71,0,101,0</INFO></NAVI> the cult." },
		Summary = "Infiltrating the Cult"
	},
	[8894] = {
		Title = "The recipient of the letter",
		IconName = "ico_ep.bmp",
		Description = { "Lalaira Wigner, at the top of Wigner, asked you to deliver a letter to <NAVI>[Captain Walter]<INFO>jalbe_in,68,46,0,101,0</INFO></NAVI>. Could it be an important letter?" },
		Summary = "Talk with Maristella Walter"
	},
	[8914] = {
		Title = "An Unexpected Timeline",
		IconName = "ico_ep.bmp",
		Description = { "I thought nothing would change within a fixed timeline, but I received a new request. Nillem's comment that this meant the present would no longer change played a role. Let's deliver a letter to <NAVI>[Lalaira Wigner]<INFO>jalbe_in,56,138,0,101,0</INFO></NAVI> in Alberta." },
		Summary = "Talk to Lalaira Wigner"
	},
	[8915] = {
		Title = "Nazar's Eye",
		IconName = "ico_ep.bmp",
		Description = { "Lalira looks genuinely surprised to receive the letter, but suggests we talk in her office. Speak with <NAVI>[Lalaira Wigner]<INFO>jalbe_in,71,174,0,101,0</INFO></NAVI> in the office at the Wigner Headquarters in Alberta." },
		Summary = "Talk to Lalaira Wigner"
	},
	[8916] = {
		Title = "Returning",
		IconName = "ico_ep.bmp",
		Description = { "Lalira has decided not to accompany you to Lunaforma. You must convey Lalira's choice to <NAVI>[Ivan]<INFO>jor_mbase,332,148,0,101,0</INFO></NAVI>, who will be waiting at Lunaforma." },
		Summary = "Talk with Ivan"
	},
	[8955] = {
		Title = "To Brimir",
		IconName = "ico_ep.bmp",
		Description = { "The <NAVI>[Advance Party]<INFO>uknw_ruin,256,238,0,101,0</INFO></NAVI> has already departed for Brimir to explore. Let's follow them and talk to them." },
		Summary = "Talk to Ellis and Maura"
	},
	[8956] = {
		Title = "Gray Valkyrie",
		IconName = "ico_ep.bmp",
		Description = { "First, it would be a good idea to talk to the <NAVI>[residents]<INFO>uknw_ruin,275,235,0,101,0</INFO></NAVI> of Brimir." },
		Summary = "Talk to Il"
	},
	[8957] = {
		Title = "A Land Without Divinity",
		IconName = "ico_ep.bmp",
		Description = { "Let's hear what <NAVI>[Ellis]<INFO>uknw_ruin,275,235,0,101,0</INFO></NAVI>, a priest among Brimir's advance party, thinks about what Il said." },
		Summary = "Talk to Ellis"
	},
	[8958] = {
		Title = "Only Valkyrie",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Other residents]<INFO>uknw_ruin,275,235,0,101,0</INFO></NAVI> of Brimir want to talk." },
		Summary = "Talk to the residents"
	},
	[8959] = {
		Title = "Exploring Brimir",
		IconName = "ico_ep.bmp",
		Description = { "I decided to speak with the three Valkyrie prisoners in Brimir and ask them for their opinions on the place. * <NAVI>[Brimir Residents]<INFO>uknw_ruin,149,150,0,101,0</INFO></NAVI> * <NAVI>[Brimir Residents]<INFO>uknw_ruin,252,59,0,101,0</INFO></NAVI> * <NAVI>[Brimir Residents]<INFO>uknw_ruin,93,174,0,101,0</INFO></NAVI>" },
		Summary = "Interviewing Brimir Residents"
	},
	[8960] = {
		Title = "God's Love",
		IconName = "ico_ep.bmp",
		Description = { "Some in Brimir believe that God imprisoned those he loved in Brimir." },
		Summary = "Interviewing Brimir Residents (1)"
	},
	[8961] = {
		Title = "A Disconnected World",
		IconName = "ico_ep.bmp",
		Description = { "Some in Brimir believe that being blocked from feeling the presence of God is proof of their belonging to God." },
		Summary = "Interviewing Brimir Residents (2)"
	},
	[8962] = {
		Title = "The Flow of Time",
		IconName = "ico_ep.bmp",
		Description = { "Some people in Brimir are counting the passage of time. However, it's a mess, sometimes counting the same number twice." },
		Summary = "Interviewing Brimir Residents (3)"
	},
	[8963] = {
		Title = "To the Square",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Il]<INFO>uknw_ruin,160,160,0,101,0</INFO></NAVI>, who was waiting in Brimir's Square, might know if there's a way to break the chains around my ankles." },
		Summary = "Talk to Il"
	},
	[8964] = {
		Title = "If you want it",
		IconName = "ico_ep.bmp",
		Description = { "Brimir's <NAVI>[Il]<INFO>uknw_ruin,160,160,0,101,0</INFO></NAVI> asks you to destroy 10 Shadow Guardians and collect the 5 Broken Petals that scatter into the air." },
		Summary = "Recover 5 Broken Petals"
	},
	[8965] = {
		Title = "Before the Flowers Bloom (1)",
		IconName = "ico_ep.bmp",
		Description = { "I've figured out how to free the Valkyrie prisoners scattered throughout Brimir. We must free those chained. First, let's find <NAVI>[Lee]<INFO>uknw_ruin,149,150,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Lee"
	},
	[8966] = {
		Title = "Before the Flowers Bloom (2)",
		IconName = "ico_ep.bmp",
		Description = { "Let's talk to <NAVI>[Sam]<INFO>uknw_ruin,252,59,0,101,0</INFO></NAVI> in Brimir." },
		Summary = "Talk with Sam"
	},
	[8967] = {
		Title = "Before the Flowers Bloom (3)",
		IconName = "ico_ep.bmp",
		Description = { "Let's talk to <NAVI>[Sa]<INFO>uknw_ruin,93,174,0,101,0</INFO></NAVI> in Brimir." },
		Summary = "Talk with Sa"
	},
	[8968] = {
		Title = "Colorful Flowers",
		IconName = "ico_ep.bmp",
		Description = { "Freed from their chains, the Valkyries didn't return to their old selves; they turned gray. Let's go back to <NAVI>[Il]<INFO>uknw_ruin,160,160,0,101,0</INFO></NAVI> in Brimir." },
		Summary = "Talk to Il"
	},
	[8969] = {
		Title = "Back to Ash Village",
		IconName = "ico_ep.bmp",
		Description = { "It seems there's nothing more to learn from Brimir for now. Report to <NAVI>[Sasha]<INFO>ygg_fruit,80,122,0,101,0</INFO></NAVI> in Ash Village." },
		Summary = "Talk to Sasha"
	},
	[8970] = {
		Title = "Formal Grave",
		IconName = "ico_ep.bmp",
		Description = { "Brimir's <NAVI>[Lee]<INFO>uknw_ruin,149,150,0,101,0</INFO></NAVI> asks you to destroy 50 Tulips and 50 Calendulas and bring him 20 Gray Petals to mourn them." },
		Summary = "Recover 20 Gray Petals"
	},
	[8971] = {
		Title = "[Standby] Formal Grave",
		IconName = "ico_ep.bmp",
		Description = { "This quest is a daily quest. When the waiting time expires, you can receive it again from <NAVI>[Lee]<INFO>uknw_ruin,149,150,0,101,0</INFO></NAVI> and complete it." },
		Summary = "Reset at 04:00"
	},
	[8972] = {
		Title = "Formal Grave",
		IconName = "ico_ep.bmp",
		Description = { "Brimir's <NAVI>[Lee]<INFO>uknw_ruin,149,150,0,101,0</INFO></NAVI> asks you to destroy 50 Tulips and 50 Calendulas and bring him 20 Gray Petals to mourn them." },
		Summary = "Recover 20 Gray Petals"
	},
	[8973] = {
		Title = "Even if the dimension is destroyed, a cat is a cat.",
		IconName = "ico_ep.bmp",
