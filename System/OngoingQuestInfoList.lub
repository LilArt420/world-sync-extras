	[24070] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "Let's <NAVI>[investigate]<INFO>ygg_roots,186,117,0,101,0</INFO></NAVI> the twisted Land of Darkness. We may find injured people or intersections." },
		Summary = "Approach the survey point"
	},
	[24071] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "While investigating the twisted Land of Darkness, I heard a <NAVI>[scream]<INFO>ygg_roots,167,135,0,101,0</INFO></NAVI>." },
		Summary = "Go where the scream came from"
	},
	[24072] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "Get close to Ivein in the Land of Darkness and lift the roots to rescue <NAVI>[Ivein]<INFO>ygg_roots,166,135,0,101,0</INFO></NAVI>." },
		Summary = "Lift the roots"
	},
	[24073] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "Go <NAVI>[north]<INFO>ygg_roots,153,203,0,101,0</INFO></NAVI> in the Land of Darkness, as Ivein said." },
		Summary = "Go north"
	},
	[24074] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "Magi says she got separated from the others in a quake. Go to the <NAVI>[place]<INFO>ygg_roots,161,237,0,101,0</INFO></NAVI> where Magi found an intersection." },
		Summary = "Talk to Magi before the intersection"
	},
	[24075] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "Let's <NAVI>[investigate]<INFO>hem_fild,208,22,0,101,0</INFO></NAVI> what lies inside the intersection in the Land of Darkness." },
		Summary = "Into the intersection"
	},
	[24076] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "I learned about the first intersection. Go back out to the Land of Darkness and talk to the <NAVI>[party]<INFO>ygg_roots,161,237,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Magi before the intersection"
	},
	[24077] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "The quake in the Land of Darkness stopped, and a <NAVI>[scream]<INFO>ygg_roots,112,246,0,101,0</INFO></NAVI> rang out. Let's go there." },
		Summary = "Go where the scream came from"
	},
	[24078] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "An investigator told me about the rest of the party. Go to the <NAVI>[place]<INFO>ygg_roots,39,268,0,101,0</INFO></NAVI> he told me about." },
		Summary = "Find the others"
	},
	[24079] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "I found what look like marks left by Tamarin. Let's <NAVI>[follow them]<INFO>ygg_roots,91,149,0,101,0</INFO></NAVI>." },
		Summary = "Find Tamarin"
	},
	[24080] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "Tamarin says she found a new intersection with Alf. Go to the <NAVI>[intersection]<INFO>ygg_roots,40,129,0,101,0</INFO></NAVI> and see." },
		Summary = "Talk to Tamarin before the intersection"
	},
	[24081] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Alf]<INFO>uknw_ruin,244,239,0,101,0</INFO></NAVI>, who was waiting in the Land of Darkness, seems to have gone into the intersection first. Go in and see what's happening." },
		Summary = "Find Alf"
	},
	[24082] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "Things inside the intersection don't look good. To tell Ash Village, let's go back <NAVI>[outside]<INFO>ygg_roots,40,129,0,101,0</INFO></NAVI> first." },
		Summary = "Talk to Tamarin before the intersection"
	},
	[24083] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "We decided to return to Ash Village to report what we learned. Look for Dew, the last of the party, along the <NAVI>[road]<INFO>ygg_roots,204,178,0,101,0</INFO></NAVI> back to the village." },
		Summary = "Walk back to the village"
	},
	[24084] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "An investigator says someone who looked like Dew went toward the village. Keep <NAVI>[going]<INFO>ygg_roots,297,200,0,101,0</INFO></NAVI>." },
		Summary = "Walk back to the village"
	},
	[24085] = {
		Title = "Regeneration",
		IconName = "ico_ep.bmp",
		Description = { "A somewhat familiar investigator saw Dew pass by on the road to the village. Go <NAVI>[east]<INFO>ygg_roots,338,243,0,101,0</INFO></NAVI> to find Dew." },
		Summary = "Find Dew"
	},
	[24086] = {
		Title = "Cool Head, Hot Hal",
		IconName = "ico_ep.bmp",
