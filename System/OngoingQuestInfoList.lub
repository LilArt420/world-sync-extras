	},
	[17925] = {
		Title = "Clover's Worry",
		IconName = "ico_ep.bmp",
		Description = { "Jeon Cheosa looked around destroyed Verus and found the problem. He'll explain the solution back in <NAVI>[Destroyed Geffen]<INFO>ch1_geffen,117,117,0,101,0</INFO></NAVI>." },
