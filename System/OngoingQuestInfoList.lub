	},
	[17921] = {
		Title = "The Identity of the Plague",
		IconName = "ico_ep.bmp",
		Description = { "Having talked over what the plague is, the party decides to share it with the <NAVI>[doctor]<INFO>ch1_gef_in,75,66,0,101,0</INFO></NAVI> of Destroyed Geffen to find a cure." },
