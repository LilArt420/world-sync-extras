		Summary = "Purification 05"
	},
	[17931] = {
		Title = "This Is a Miraculous Prescription",
		IconName = "ico_ep.bmp",
		Description = { "I gave Purification Amulets to the people of destroyed Verus. Go back to Destroyed Geffen and report to <NAVI>[Jeon Cheosa]<INFO>ch1_geffen,117,117,0,101,0</INFO></NAVI>." },
		Summary = "To Jeon Cheosa"
	},
	[17932] = {
		Title = "[Standby] This Is a Miraculous Prescription",
		IconName = "ico_ep.bmp",
		Description = { "The amulets only last a day. After dawn, go back to <NAVI>[Jeon Cheosa]<INFO>ch1_geffen,117,117,0,101,0</INFO></NAVI> in Destroyed Geffen for new ones." },
		Summary = "Reset at 04:00"
	},
	[17933] = {
		Title = "Save Them First",
		IconName = "ico_ep.bmp",
		Description = { "Deal with the monsters threatening the people of <NAVI>[destroyed Verus]<INFO>hem_dun01,20,89,0,101,0</INFO></NAVI> so they can live in safety." },
		Summary = "Destroyed Verus"
	},
	[17934] = {
		Title = "[Standby] Save Them First",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Clover]<INFO>ch1_geffen,122,118,0,101,0</INFO></NAVI> of Destroyed Geffen worries about the monsters multiplying in Verus, and asks me to deal with them again after dawn." },
		Summary = "Reset at 04:00"
	},
	[18220] = {
		Title = "To the Ice Castle",
		IconName = "ico_ep.bmp",
		Description = { "We've received the assistance of Lord Nyar. Let's return to the Ice Castle and check in with <NAVI>[Leon]<INFO>icas_in,111,228,0,101,0</INFO></NAVI> and our comrades." },
		Summary = "Conversation with Leon"
	},
	[18221] = {
		Title = "Finding Lehar...!",
		IconName = "ico_ep.bmp",
		Description = { "We've decided to find Lehar at the first floor of the Snake's Roots. Let's investigate the <NAVI>[Marker]<INFO>jor_root1,32,75,0,101,0</INFO></NAVI>." },
		Summary = "Investigate the Marker"
	},
	[18222] = {
		Title = "Investigation, Investigation, Investigation",
		IconName = "ico_ep.bmp",
		Description = { "After investigating the mark left in the Snake's Roots, Lehar suggested exchanging information at the Sacred Roots. There are a total of three marked locations." },
		Summary = "Investigate 3 Marks"
	},
	[18223] = {
		Title = "Lehar's Mark 1",
		IconName = "ico_ep.bmp",
		Description = { "One of Lehar's <NAVI>[marks]<INFO>jor_root1,69,128,0,101,0</INFO></NAVI> left in the Snake's Roots 1st floor. There's a long path leading inside. Let's check if there's Bagot's laboratory inside." },
		Summary = "Investigate the Mark"
	},
	[18224] = {
		Title = "Lehar's Mark 2",
		IconName = "ico_ep.bmp",
		Description = { "One of Lehar's <NAVI>[marks]<INFO>jor_root1,35,211,0,101,0</INFO></NAVI> left in the Snake's Roots 1st floor. There's a long path leading inside. Let's check if there's Bagot's laboratory inside." },
		Summary = "Investigate the Mark"
	},
	[18225] = {
		Title = "Lehar's Mark 3",
		IconName = "ico_ep.bmp",
		Description = { "One of Lehar's <NAVI>[marks]<INFO>jor_root1,254,66,0,101,0</INFO></NAVI> left in the Snake's Roots 1st floor. There's a long path leading inside. Let's check if there's Bagot's laboratory inside." },
		Summary = "Investigate the Mark"
	},
	[18226] = {
		Title = "It's Just a Hoax. The Next Location.",
		IconName = "ico_ep.bmp",
		Description = { "Even after investigating all the marks left in the Snake's Roots 1st floor, we couldn't find the entrance to Bagot's laboratory. Let's meet Lehar and Miriam at the <NAVI>[Sacred Roots]<INFO>jor_sanct,133,86,0,101,0</INFO></NAVI>." },
		Summary = "Investigate the Marks"
	},
	[18227] = {
		Title = "Investigating the Sacred Roots",
		IconName = "ico_ep.bmp",
		Description = { "Lehar and Miriam have decided to investigate the interior of the Sacred Roots together. Let's go to the central area and talk to <NAVI>[Bishop Rgan]<INFO>jor_sanct,150,207,0,101,0</INFO></NAVI> to gather information." },
		Summary = "Conversation with the Bishop"
	},
	[18228] = {
		Title = "Nyar's Call",
		IconName = "ico_ep.bmp",
		Description = { "Lured by a massive vibration, we arrived at the Small Twig Nest. The <NAVI>[White Cat]<INFO>jor_twig,187,198,0,101,0</INFO></NAVI> in the Small Twig Nest seems to have something to say. It looks urgent." },
		Summary = "Conversation with the White Cat"
	},
	[18229] = {
		Title = "Step on the Cats' Backs and Run!",
		IconName = "ico_ep.bmp",
		Description = { "Another massive vibration has occurred. It seems something is happening inside the Small Twig Nest <NAVI>[Inner Area]<INFO>jor_twig,180,123,0,101,0</INFO></NAVI>. Let's go and check it out!" },
		Summary = "Conversation with the White Cat"
	},
	[18230] = {
		Title = "Was Everyone Here?",
		IconName = "ico_ep.bmp",
		Description = { "Bagot and Rasgand, who we've been looking for, have somehow infiltrated the Small Twig Nest. We need to help <NAVI>[Nyar]<INFO>jor_twig,142,153,0,101,0</INFO></NAVI> and Leon, who are facing off against Rasgand." },
		Summary = "Conversation with the White Cat"
	},
	[18231] = {
		Title = "So, What Happened?",
		IconName = "ico_ep.bmp",
		Description = { "Rasgand, who infiltrated the Small Twig Nest, disappeared with <NAVI>[Nyar]<INFO>jor_twig,142,153,0,101,0</INFO></NAVI>'s doppelganger. Let's ask <NAVI>[Leon]<INFO>jor_twig,138,157,0,101,0</INFO></NAVI> about Rasgand's whereabouts." },
		Summary = "Conversation with Leon"
	},
	[18232] = {
		Title = "Separated Sanctuary",
		IconName = "ico_ep.bmp",
		Description = { "Before Rasgand could steal the power of the World Tree and the Nest, he was isolated in a different dimension. Nyar, who forcibly separated Rasgand, seems to be struggling to maintain the barrier. Let's go to the 'Separated Sanctuary' through <NAVI>[Aurelie]<INFO>jor_twig,138,152,0,101,0</INFO></NAVI> and stop Rasgand." },
		Summary = "Neutralize Rasgand"
	},
	[18233] = {
		Title = "The Undying One",
		IconName = "ico_ep.bmp",
		Description = { "Rasgand, who absorbed the power of Imir's Heart Shard, was an opponent we couldn't defeat. However, now that we have the tainted Imir's Heart Shard, let's return to <NAVI>[Ice Castle]<INFO>icecastle,158,204,0,101,0</INFO></NAVI>. Chichiring knows the location of <NAVI>[Voglinde]<INFO>icecastle,75,126,0,101,0</INFO></NAVI>." },
		Summary = "Conversation with Voglinde"
	},
	[18234] = {
		Title = "Iwin's Iwin Worry",
		IconName = "ico_ep.bmp",
		Description = { "A request from Ice Castle's <NAVI>[Chichiring]<INFO>icecastle,75,126,0,101,0</INFO></NAVI>. In order to ensure the safety of the ancient Ice Winds, you must defeat the monsters in the Deep Roots Cave." },
		Summary = "Defeat 30 monsters in the Deep Roots Cave"
	},
	[18235] = {
		Title = "[Standby] Iwin's Iwin Worry",
		IconName = "ico_dq.bmp",
		Description = { "This quest is a daily quest and can be accepted again after the cooldown period expires. You can receive the quest from <NAVI>[Chichiring]<INFO>icecastle,75,126,0,101,0</INFO></NAVI> in Ice Castle." },
		Summary = "04:00 Reset"
	},
	[18236] = {
		Title = "Voglinde's Extermination Operation 1",
		IconName = "ico_ep.bmp",
		Description = { "Issgard's <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> wants to exterminate the monsters coming out of the 1st floor of the Snake's Roots. Let's go wild with them!" },
		Summary = "Defeat 30 Rgans on the Roots 1st floor"
	},
	[18237] = {
		Title = "[Standby] Voglinde's Extermination Operation 1",
		IconName = "ico_dq.bmp",
		Description = { "This quest is a daily quest and can be accepted again after the cooldown period expires. You can receive the quest from <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> in Issgard." },
		Summary = "04:00 Reset"
	},
	[18238] = {
		Title = "Voglinde's Extermination Operation 2",
		IconName = "ico_ep.bmp",
		Description = { "Issgard's <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> wants to exterminate the monsters coming out of the 2nd floor of the Snake's Roots. Let's go wild with them!" },
		Summary = "Defeat 30 Rgans on the Roots 2nd floor"
	},
	[18239] = {
		Title = "[Standby] Voglinde's Extermination Operation 2",
		IconName = "ico_dq.bmp",
		Description = { "This quest is a daily quest and can be accepted again after the cooldown period expires. You can receive the quest from <NAVI>[Voglinde]<INFO>icas_in2,253,118,0,101,0</INFO></NAVI> in Issgard." },
		Summary = "04:00 Reset"
	},
	[18334] = {
		Title = "A Rift Detected in the North",
		IconName = "ico_ep.bmp",
		Description = { "Nillem believes a rift has opened on Scale Island, near Issgard, and wants to look into it. <NAVI>[Shupapa]<INFO>jor_tail,233,41,0,101,0</INFO></NAVI>, waiting at the Frozen Tail, can take you to Scale Island." },
		Summary = "Talk to Nyar"
	},
	[18335] = {
		Title = "The Rift on Scale Island",
		IconName = "ico_ep.bmp",
		Description = { "You crossed into the Scale Island of the past with Nyar. Somewhere in this time lies the source of Rasgand's power, and it has to be destroyed. Talk to <NAVI>[Nyar]<INFO>jor_crk_p,105,108,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Nyar"
	},
	[18336] = {
		Title = "First Meeting",
		IconName = "ico_ep.bmp",
		Description = { "While you were planning your next move on the Scale Island of the past, you sensed someone nearby. Meet whoever is <NAVI>[near the rift]<INFO>jor_crk_p,95,93,0,101,0</INFO></NAVI>." },
		Summary = "Meet someone near the rift"
	},
	[18337] = {
		Title = "To Lunaforma",
		IconName = "ico_ep.bmp",
		Description = { "The one you met on the Scale Island of the past was Ivan Wigner. Go with <NAVI>[Ivan]<INFO>jor_crk_p,95,93,0,101,0</INFO></NAVI> and his soldier to <NAVI>[Lunaforma]<INFO>jor_mbase,124,32,0,101,0</INFO></NAVI>." },
		Summary = "Talk to a soldier in Lunaforma"
	},
	[18338] = {
		Title = "Gathering Witnesses",
		IconName = "ico_ep.bmp",
		Description = { "You decided to gather information about the giant serpent. Is it real? Hear the people who made it back to Lunaforma." },
		Summary = "Collect 3 accounts"
	},
	[18339] = {
		Title = "Witness 1",
		IconName = "ico_ep.bmp",
		Description = { "An exhausted soldier says he saw a vile, slimy serpent monster." },
		Summary = ""
	},
	[18340] = {
		Title = "Witness 2",
		IconName = "ico_ep.bmp",
		Description = { "A believer who escaped the cult says he saw the serpent monster eat people." },
		Summary = ""
	},
	[18341] = {
		Title = "Witness 3",
		IconName = "ico_ep.bmp",
		Description = { "A wounded soldier has the scars of huge scales across his back." },
		Summary = ""
	},
	[18342] = {
		Title = "All Accounts Gathered!",
		IconName = "ico_ep.bmp",
		Description = { "You have all the accounts. Report to <NAVI>[Tris]<INFO>jor_mbase,204,193,0,101,0</INFO></NAVI> in front of the central barracks." },
		Summary = "Talk to Tris"
	},
	[18343] = {
		Title = "Looking for Tan and Nadoyo",
		IconName = "ico_ep.bmp",
		Description = { "Tris is worried: Tan and Nadoyo haven't come back. Look for them in the <NAVI>[north of the Raised Land]<INFO>jor_raise1,199,190,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Nadoyo"
	},
	[18344] = {
		Title = "A Suspicious Place in the Temple",
		IconName = "ico_ep.bmp",
		Description = { "With Tan, Nadoyo and Reinhardt you will check a suspicious spot outside Gimle. Examine the <NAVI>[ornamental door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI> outside the temple." },
		Summary = "Examine the ornamental door"
	},
	[18345] = {
		Title = "The Serpent's Lair?",
		IconName = "ico_ep.bmp",
		Description = { "It seems the cult has made a giant serpent. Hurry back to Lunaforma and tell <NAVI>[Tris]<INFO>jor_mbase,204,193,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Tris"
	},
	[18346] = {
		Title = "Left Out of the Last Battle",
		IconName = "ico_ep.bmp",
		Description = { "Tris and the resistance will face the giant serpent. Discuss what comes next with your companions in the <NAVI>[small room]<INFO>mbase_in,64,184,0,101,0</INFO></NAVI> of the central barracks." },
		Summary = "Talk to Nyar"
	},
	[18347] = {
		Title = "I Can't Sit This Out!",
		IconName = "ico_ep.bmp",
		Description = { "Heine urges you to join the battle against the serpent. Hurry to the <NAVI>[ornamental door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI> before Tris and the others face it." },
		Summary = "Talk to Nadoyo"
	},
	[18348] = {
		Title = "Joining the Last Battle",
		IconName = "ico_ep.bmp",
		Description = { "Your comrades are searching the hidden place behind the <NAVI>[ornamental door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI> for the giant serpent. Fight beside Tris in the last battle recorded in history." },
		Summary = "Fight in the Last Battle"
	},
	[18349] = {
		Title = "Carried Off by a Cat",
		IconName = "ico_ep.bmp",
		Description = { "Nyar appeared out of nowhere and carried you off. She had followed Jormungandr's mana to a hidden space behind the <NAVI>[ornamental altar]<INFO>jor_tmple1,170,307,0,101,0</INFO></NAVI> of Gimle. Follow her." },
		Summary = "Talk to Nyar"
	},
	[18350] = {
		Title = "Gimle's Suspicious Book",
		IconName = "ico_ep.bmp",
		Description = { "Behind Gimle's <NAVI>[altar]<INFO>jor_tmple1,170,307,0,101,0</INFO></NAVI> lies a hidden room with a very suspicious book. Nillem says it is some kind of mechanism and tells you to press it..." },
		Summary = "Press the suspicious book"
	},
	[18351] = {
		Title = "The Shining Door",
		IconName = "ico_ep.bmp",
		Description = { "Pressing the book opened a shining door below the <NAVI>[altar]<INFO>jor_tmple1,170,307,0,101,0</INFO></NAVI>. Jormungandr's mana pours out of it. Go in!" },
		Summary = "Through the shining door"
	},
	[18352] = {
		Title = "A Real Mission at Last!",
		IconName = "ico_ep.bmp",
		Description = { "The hidden place behind the <NAVI>[altar]<INFO>jor_tmple1,170,307,0,101,0</INFO></NAVI> leads further. Follow the surging mana and destroy Jormungandr's mana before it gathers in Rasgand." },
		Summary = "Break the secret altar"
	},
	[18353] = {
		Title = "The Source Is Cut Off",
		IconName = "ico_ep.bmp",
		Description = { "After all that, Nyar seems to have caught the mana meant for Rasgand. Discuss the next steps with <NAVI>[Nyar]<INFO>jor_crk_p,105,108,0,101,0</INFO></NAVI> on the Scale Island of the past." },
		Summary = "Talk to Nyar"
	},
	[18354] = {
		Title = "Heine's Gift",
		IconName = "ico_ep.bmp",
		Description = { "Ilse el Heine called through the tablet: take the new tablet she hid in the <NAVI>[bushes]<INFO>jor_mbase,129,43,0,101,0</INFO></NAVI> near the Lunaforma ferry." },
		Summary = "Search the bushes"
	},
	[18355] = {
		Title = "Back to Scale Island",
		IconName = "ico_ep.bmp",
		Description = { "Return to the <NAVI>[Scale Island]<INFO>jor_crk,137,138,0,101,0</INFO></NAVI> of your own time and see whether everything went as planned." },
		Summary = "To Scale Island"
	},
	[18356] = {
		Title = "Time to Check the Consequences",
		IconName = "ico_ep.bmp",
		Description = { "Go to the Nest of Small Branches and check on Rasgand. <NAVI>[Nyar's Double]<INFO>jor_twig,122,164,0,101,0</INFO></NAVI> can tell how the sealed Rasgand's mana is doing." },
		Summary = "Talk to Nyar's Double"
	},
	[18357] = {
		Title = "Time to Settle the Curse",
		IconName = "ico_ep.bmp",
		Description = { "Voglinde and Lehar went into the barrier to see the end of the curse. Wait and pray they succeed. <NAVI>[Nyar's Double]<INFO>jor_twig,122,164,0,101,0</INFO></NAVI> will know." },
		Summary = "Wait, then talk to Nyar's Double"
	},
	[18358] = {
		Title = "Rasgand?",
		IconName = "ico_ep.bmp",
		Description = { "Rasgand keeps coming back to life. To check one possibility, you will go into the barrier yourself. Enter the Serene Sanctuary through <NAVI>[Nyar's Double]<INFO>jor_twig,122,164,0,101,0</INFO></NAVI>." },
		Summary = "Check the Serene Sanctuary"
	},
	[18359] = {
		Title = "Butterfly Effect",
		IconName = "ico_ep.bmp",
		Description = { "As you thought: the Rasgand inside the barrier was not Rasgand. The mana of the shard of Ymir's heart was imitating him. Tell <NAVI>[Nyar's Double]<INFO>jor_twig,122,164,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Nyar's Double"
	},
	[18360] = {
		Title = "The Frozen Age of Heroes",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Nyar]<INFO>jor_crk,105,108,0,101,0</INFO></NAVI> and Nillem, closing the rift on Scale Island, say something strange has happened. Go to Scale Island." },
		Summary = "Talk to Nyar"
	},
	[18361] = {
		Title = "Nyar's Primeval Pouch",
		IconName = "ico_ep.bmp",
		Description = { "Nyar showed off her primeval pouch." },
		Summary = "Talk to Nyar"
	},
	[18368] = {
		Title = "The World Tree's Call (1)",
		IconName = "ico_ep.bmp",
		Description = { "Unbelievable, but the World Tree has called me! A Laphine Herald near Prontera and Payon will guide me to Ash Village. Touching a Small Ash Tree makes a Laphine Herald appear." },
		Summary = "To Ash Village"
	},
	[18369] = {
		Title = "The World Tree's Call (2)",
		IconName = "ico_ep.bmp",
		Description = { "The herald who guided me to Ash Village went back to invite other adventurers. Let's meet <NAVI>[Sasha]<INFO>ygg_fruit,80,122,0,101,0</INFO></NAVI> of the Laphine." },
		Summary = "Talk to Sasha"
	},
	[18370] = {
		Title = "The World Tree's Call (3)",
		IconName = "ico_ep.bmp",
		Description = { "While hearing many stories in Ash Village, I was told to talk to <NAVI>[Meisel]<INFO>ygg_fruit,84,119,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Meisel"
	},
	[18371] = {
		Title = "The Twisted Land of Darkness",
		IconName = "ico_ep.bmp",
		Description = { "I decided to see the state of the twisted Land of Darkness for myself. The branch path of Ash Village leads down to the <NAVI>[Land of Darkness]<INFO>ygg_roots,333,139,0,101,0</INFO></NAVI>." },
		Summary = "Go to the Land of Darkness"
	},
	[18372] = {
		Title = "To Destroyed Geffen",
		IconName = "ico_ep.bmp",
		Description = { "Of the intersections that appeared in the twisted Land of Darkness, we decided to investigate the one to the second world's Destroyed Geffen first. Let's meet <NAVI>[Jeon Cheosa]<INFO>ygg_roots,164,231,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Jeon Cheosa"
	},
	[18373] = {
		Title = "Ingredients for Fire Resistance",
		IconName = "ico_ep.bmp",
		Description = { "A fire resistance potion is needed to explore the hot regions. Devries asks for 5 Dragon Scales. Bring them to <NAVI>[Devries]<INFO>ygg_fruit,71,78,0,101,0</INFO></NAVI> in the Tube Fruit house of Ash Village." },
		Summary = "5 Dragon Scales for Devries"
	},
	[18374] = {
		Title = "Bad News",
		IconName = "ico_ep.bmp",
		Description = { "It seems hard to fight the plague of Destroyed Geffen perfectly. Let's talk to <NAVI>[Sasha]<INFO>ygg_fruit,80,122,0,101,0</INFO></NAVI> in Ash Village." },
		Summary = "Talk to Sasha"
	},
	[18375] = {
		Title = "Good News",
		IconName = "ico_ep.bmp",
		Description = { "The last clue to the cure seems to lie in Muspelheim. Before going there, get fire resistance from <NAVI>[Devries]<INFO>ygg_fruit,71,78,0,101,0</INFO></NAVI> in the Tube Fruit house." },
		Summary = "Talk to Devries"
	},
	[18376] = {
		Title = "To the Land of Heat",
		IconName = "ico_ep.bmp",
		Description = { "Everything is ready for Muspelheim's Volund Valley. Find the advance party in <NAVI>[Volund Valley]<INFO>mu_fild01,95,154,0,101,0</INFO></NAVI>. It can be reached through an intersection of the twisted Land of Darkness." },
		Summary = "Find the advance party in Volund Valley"
	},
	[18377] = {
		Title = "The Unknown Being",
		IconName = "ico_ep.bmp",
		Description = { "We must find out about the suspicious being that can tear through the dimensions. Talk to <NAVI>[Sasha]<INFO>ygg_fruit,80,122,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Sasha"
	},
	[18378] = {
		Title = "To Ash Village",
		IconName = "ico_ep.bmp",
		Description = { "I took a quick look around the Land of Darkness. Let's return to Ash Village and talk about what comes next. <NAVI>[Sasha]<INFO>ygg_fruit,80,122,0,101,0</INFO></NAVI> of the Laphine will tell me." },
		Summary = "Talk to Sasha"
	},
	[18379] = {
		Title = "The Blurry Gate",
		IconName = "ico_ep.bmp",
		Description = { "Rubiel asked me to come to the Geffen field of the second world. Find the <NAVI>[designated spot]<INFO>hem_fild,180,263,0,101,0</INFO></NAVI> on the Geffen field and meet Rubiel." },
		Summary = "Meet Rubiel at the designated spot"
	},
	[19184] = {
		Title = "Meeting Counselor Ulus",
		IconName = "ico_ep.bmp",
		Description = { "You met Counselor Ulus." },
		Summary = ""
	},
	[19185] = {
		Title = "[Standby] Those Haunted by Nightmares",
		IconName = "ico_dq.bmp",
		Description = { "<NAVI>[Counselor Ulus]<INFO>jor_albe,160,137,0,101,0</INFO></NAVI> hopes you'll help again tomorrow." },
		Summary = "Reset at 04:00"
	},
	[19186] = {
		Title = "Counselling Request",
		IconName = "ico_ep.bmp",
		Description = { "Request form. Name: <NAVI>[Yukter Ppuppu]<INFO>jor_albe,89,103,0,101,0</INFO></NAVI>. Left everything at home to escape the cult. Pretends not to, but misses home terribly. Listen well." },
		Summary = "Talk to Yukter Ppuppu"
	},
	[19187] = {
		Title = "Counselling Request",
		IconName = "ico_ep.bmp",
		Description = { "Request form. Name: <NAVI>[Totor Amber]<INFO>jor_albe,136,196,0,101,0</INFO></NAVI>. Has nightmares since seeing the refugees brought to Alberta. Help ease the shock." },
		Summary = "Talk to Totor Amber"
	},
	[19188] = {
		Title = "Counselling Request",
		IconName = "ico_ep.bmp",
		Description = { "Request form. Name: <NAVI>[Gaerju Sansha]<INFO>jor_albe,49,244,0,101,0</INFO></NAVI>. Rescued from the cult's prison by the resistance. Acts tough; probably isn't." },
		Summary = "Talk to Gaerju Sansha"
	},
	[19189] = {
		Title = "Counselling Request",
		IconName = "ico_ep.bmp",
		Description = { "Request form. Name: <NAVI>[Mogaja Shield]<INFO>jor_albe,116,214,0,101,0</INFO></NAVI>. Rescued from the cult at the last moment. Still stammers. Be patient." },
		Summary = "Talk to Mogaja Shield"
	},
	[19190] = {
		Title = "Counselling Done",
		IconName = "ico_ep.bmp",
		Description = { "The session went well. Go to <NAVI>[Counselor Ulus]<INFO>jor_albe,160,137,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Counselor Ulus"
	},
	[19191] = {
		Title = "Meeting Yukter Ppuppu",
		IconName = "ico_ep.bmp",
		Description = { "You met Yukter Ppuppu." },
		Summary = ""
	},
	[19192] = {
		Title = "Meeting Totor Amber",
		IconName = "ico_ep.bmp",
		Description = { "You met Totor Amber." },
		Summary = ""
	},
	[19193] = {
		Title = "Meeting Gaerju Sansha",
		IconName = "ico_ep.bmp",
		Description = { "You met Gaerju Sansha." },
		Summary = ""
	},
	[19194] = {
		Title = "Meeting Mogaja Shield",
		IconName = "ico_ep.bmp",
		Description = { "You met Mogaja Shield." },
		Summary = ""
	},
	[19195] = {
		Title = "Meeting Libra",
		IconName = "ico_ep.bmp",
		Description = { "You met Libra." },
		Summary = ""
	},
	[19196] = {
		Title = "News by Scent",
		IconName = "ico_ep.bmp",
		Description = { "Libra wants a crumpled paper delivered to someone in the <NAVI>[middle of the camp]<INFO>jor_base,131,182,0,101,0</INFO></NAVI>." },
		Summary = "Deliver the paper"
	},
	[19197] = {
		Title = "[Standby] News by Scent",
		IconName = "ico_dq.bmp",
		Description = { "You did what <NAVI>[Libra]<INFO>jor_base,314,138,0,101,0</INFO></NAVI> asked. There may be more tomorrow." },
		Summary = "Reset at 04:00"
	},
	[19198] = {
		Title = "Volunteer Balun Wok",
		IconName = "ico_ep.bmp",
		Description = { "You met Balun Wok." },
		Summary = ""
	},
	[19199] = {
		Title = "[Standby] Never Enough Food",
		IconName = "ico_dq.bmp",
		Description = { "You brought <NAVI>[Balun Wok]<INFO>jor_mbase,213,280,0,101,0</INFO></NAVI> today's food. Help again tomorrow?" },
		Summary = "Reset at 04:00"
	},
	[19200] = {
		Title = "Food Run (Fishing)",
		IconName = "ico_ep.bmp",
		Description = { "Catch 10 of the same seafood and bring them to <NAVI>[Balun Wok]<INFO>jor_mbase,213,280,0,101,0</INFO></NAVI>. Fishing spots: <NAVI>[north-east]<INFO>jor_mbase,295,288,0,101,0</INFO></NAVI>, <NAVI>[east]<INFO>jor_mbase,331,194,0,101,0</INFO></NAVI>, <NAVI>[south]<INFO>jor_mbase,189,26,0,101,0</INFO></NAVI>, <NAVI>[west]<INFO>jor_mbase,21,93,0,101,0</INFO></NAVI>, <NAVI>[north-west]<INFO>jor_mbase,23,151,0,101,0</INFO></NAVI>." },
		Summary = "10 of the same catch"
	},
	[19201] = {
		Title = "Food Run (Grass)",
		IconName = "ico_ep.bmp",
		Description = { "Gather 10 of the same kind of edible grass around Lunaforma and bring them to <NAVI>[Balun Wok]<INFO>jor_mbase,213,280,0,101,0</INFO></NAVI>." },
		Summary = "10 of the same grass"
	},
	[19202] = {
		Title = "Food Run (Seasoning)",
		IconName = "ico_ep.bmp",
		Description = { "Balun Wok asks you to scrape the glittering natural seasoning off the rocks of the <NAVI>[Lunaforma beach]<INFO>jor_mbase,340,30,0,101,0</INFO></NAVI>." },
		Summary = "Scrape the salt"
	},
	[19203] = {
		Title = "Food Run (Seasoning)",
		IconName = "ico_ep.bmp",
		Description = { "You have the seasoning. Take it to <NAVI>[Balun Wok]<INFO>jor_mbase,213,280,0,101,0</INFO></NAVI>." },
		Summary = "To Balun Wok"
	},
	[19225] = {
		Title = "Exploring the Fantasy Book",
		IconName = "ico_ep.bmp",
		Description = { "Professor Telkos turned the diary from our adventure into a Fantasy Book. Let's step into <NAVI>[A Doctor's Record..]<INFO>ygg_edge,211,211,0,101,0</INFO></NAVI>. To stop reading, look at the central fountain of the recreated Geffen. Telkos asks: 1) don't quarrel with other readers; 2) these events are over, so don't lose yourself in them or try to change them." },
		Summary = "Enter A Doctor's Record.."
	},
	[19226] = {
		Title = "Fantasy Book Explored",
		IconName = "ico_ep.bmp",
		Description = { "I finished exploring the Fantasy Book \"A Doctor's Record..\". Shall I report to <NAVI>[Professor Telkos]<INFO>ygg_edge,209,209,0,101,0</INFO></NAVI>? To stop reading, look at the central fountain of the recreated Geffen." },
		Summary = "Talk to Professor Telkos"
	},
	[23100] = {
		Title = "Ancient Deep Sea",
		IconName = "ico_ep.bmp",
		Description = { "In the confrontation situation with Rasgand, it's possible that Jormungandr saved us. To find the place where you met the White Cat, visit <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Diving Iwin"
	},
	[23101] = {
		Title = "No Matter How Deep, I Can Find It 1",
		IconName = "ico_ep.bmp",
		Description = { "Diving Iwin from the Ice Castle suggests that he needs a high-calorie meal to swim to the Frozen Zone. Hunt 5 Ice Gangus nearby and bring 3 Frozen Beetle Shells." },
		Summary = "5 Ice Gangus, 3 Frozen Insect Shells"
	},
	[23102] = {
		Title = "No Matter How Deep, I Can Find It 2",
		IconName = "ico_ep.bmp",
		Description = { "Diving Iwin from the Ice Castle suggests that he needs a protective suit made of shining seaweed to swim to the Frozen Zone. Collect 5 Luminous Seaweeds nearby and bring 3 Luminous Seaweed Stems." },
		Summary = "5 Shining Seaweeds, 3 Shiny Seaweed Stems"
	},
	[23103] = {
		Title = "Hidden in the Ice",
		IconName = "ico_ep.bmp",
		Description = { "You've arrived at the Frozen Zone. It's a different place from where you met the White Cat... Check with <NAVI>[Kororo]<INFO>jor_twice,235,111,0,101,0</INFO></NAVI> what's going on here. If you get lost on your way to the Frozen Zone, find <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle." },
		Summary = "Talk to Kororo"
	},
	[23104] = {
		Title = "Hidden in the Ice",
		IconName = "ico_ep.bmp",
		Description = { "You've arrived at the Frozen Zone. Now you just need to find the spot where you met the White Cat. There's no plan, but you decided to move anyway. Let's go wherever your feet take you. If you leave the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> will take you back." },
		Summary = "Find the White Cat"
	},
	[23105] = {
		Title = "Hidden in the Ice",
		IconName = "ico_ep.bmp",
		Description = { "Where on earth is this...? It seems like you're wandering around without a plan, but this is the only way to find the White Cat. Keep exploring the <NAVI>[Frozen Zone]<INFO>jor_twice,158,243,0,101,0</INFO></NAVI>. If you leave the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> will take you back." },
		Summary = "Find the White Cat again"
	},
	[23106] = {
		Title = "A Nest of Small Branches",
		IconName = "ico_ep.bmp",
		Description = { "You found a spot where you can sense the magic of Jormungandr and met a cat. However, the cat led Leon and Aurelie away. Let's follow them with <NAVI>[Lehar]<INFO>jor_twice,235,111,0,101,0</INFO></NAVI> in the Frozen Zone. If you've left the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle will take you back." },
		Summary = "Find Leon and Aurelie"
	},
	[23107] = {
		Title = "A Nest of Small Branches",
		IconName = "ico_ep.bmp",
		Description = { "Leo seems to have too much on his mind after arriving at the Nest of Small Branches. Let's give him some time to sort his thoughts and then try talking to him." },
		Summary = "Talk to Leon"
	},
	[23108] = {
		Title = "Across the Iceberg and the Frozen Sea",
		IconName = "ico_ep.bmp",
		Description = { "You received an explanation about the Sanctum from Leon and Aurelie. Return to the <NAVI>[Frozen Zone]<INFO>jor_twice,161,243,0,101,0</INFO></NAVI> and share the information about the Nest of Small Branches with your companions. If you've left the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle will take you back." },
		Summary = "Talk to Aurelie"
	},
	[23109] = {
		Title = "Across the Iceberg and the Frozen Sea",
		IconName = "ico_ep.bmp",
		Description = { "You received an explanation about the Sanctum from Aurelie. It seems like the followers of Jormungandr in the Frozen Zone are trying to absorb Jormungandr's magic. Defeat 5 Jormungandr Cult Ritualists nearby and return to <NAVI>[Aurelie]<INFO>jor_twice,161,243,0,101,0</INFO></NAVI> in the Frozen Zone. If you've left the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle will take you back." },
		Summary = "Defeat 5 Jormungandr Cult Ritualists"
	},
	[23110] = {
		Title = "[Standby] Pulling Out Jormungandr's Roots",
		IconName = "ico_dq.bmp",
		Description = { "It seems like you've done enough for today. If the threat is too great, it might backfire, so if you want to clear out the Jormungandr Cult Ritualists in the Frozen Zone, wait until tomorrow." },
		Summary = "Resets at 04:00"
	},
	[23111] = {
		Title = "Pulling Out Jormungandr's Roots",
		IconName = "ico_ep.bmp",
		Description = { "You've received a request from <NAVI>[Kororo]<INFO>jor_twice,235,111,0,101,0</INFO></NAVI>. Let's confront the Jormungandr Cult Ritualists wandering in the Frozen Zone. If you've left the Frozen Zone, <NAVI>[Diving Iwin]<INFO>icecastle,141,212,0,101,0</INFO></NAVI> in the Ice Castle will take you back." },
		Summary = "Defeat 15 Jormun Warlocks"
	},
	[23112] = {
		Title = "The Serpent's Maze",
		IconName = "ico_ep.bmp",
		Description = { "You've decided to infiltrate the Serpent's Maze. Let's find <NAVI>[Lehar]<INFO>jor_maze,142,73,0,101,0</INFO></NAVI> inside the Maze." },
		Summary = "Talk to Lehar"
	},
	[23113] = {
		Title = "Gathering Rumors Among Jormungandrs 1",
		IconName = "ico_ep.bmp",
		Description = { "Listen to the conversations among the Jormungandr followers inside the Serpent's Maze at <NAVI>[Jormungandr]<INFO>jor_maze,52,238,0,101,0</INFO></NAVI>." },
		Summary = ""
	},
	[23114] = {
		Title = "Gathering Rumors Among Jormungandrs 2",
		IconName = "ico_ep.bmp",
		Description = { "Listen to the conversations among the Jormungandr followers inside the Serpent's Maze at <NAVI>[Jormungandr]<INFO>jor_maze,154,244,0,101,0</INFO></NAVI>." },
		Summary = ""
	},
	[23115] = {
		Title = "Gathering Rumors Among Jormungandrs 3",
		IconName = "ico_ep.bmp",
		Description = { "Listen to the conversations among the Jormungandr followers inside the Serpent's Maze at <NAVI>[Jormungandr]<INFO>jor_maze,281,191,0,101,0</INFO></NAVI>." },
		Summary = ""
	},
	[23116] = {
		Title = "The Cat at the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "The Serpent's Maze feels even more mysterious than before. What could have happened in the meantime? Let's gather rumors among the Jormungandr followers." },
		Summary = "Gather rumors inside the Serpent's Maze"
	},
	[23117] = {
		Title = "The Cat at the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "It seems like you've gathered enough rumors among the Jormungandr followers in the Serpent's Maze. Return to the <NAVI>[Meeting Place]<INFO>jor_maze,150,33,0,101,0</INFO></NAVI> within the Maze." },
		Summary = "Talk to Miriam"
	},
	[23118] = {
		Title = "The Cat at the End of the Maze",
		IconName = "ico_ep.bmp",
		Description = { "You've shared the rumors collected by your group inside the Serpent's Maze. Now, let's go further inside the <NAVI>[Inside the Maze]<INFO>jor_maze,197,35,0,101,0</INFO></NAVI>." },
		Summary = "Go further inside the Serpent's Maze"
	},
	[23240] = {
		Title = "The Georborg Resistance",
		IconName = "ico_ep.bmp",
		Description = { "The moment you reach Lunaforma, the Georborg resistance's base, you hear shouting. From the soldiers' faces, the ones being shouted at are the resistance's <NAVI>[captain]<INFO>jor_mbase,56,152,0,101,0</INFO></NAVI> and vice-captain. Lehar and Nillem suggest listening quietly, out of the line of fire." },
		Summary = "Listen to the argument"
	},
	[23241] = {
		Title = "The Georborg Resistance",
		IconName = "ico_ep.bmp",
		Description = { "The believers of Freyja, unhappy with a resistance built around Odin, left Lunaforma to look for another home. Once things calm down, a <NAVI>[resistance soldier]<INFO>jor_mbase,54,155,0,101,0</INFO></NAVI> waves you over." },
		Summary = "Talk to a resistance soldier"
	},
	[23242] = {
		Title = "The Georborg Resistance",
		IconName = "ico_ep.bmp",
		Description = { "Tris welcomed you, Lehar and Nillem when you said you wanted to join. Until there is a proper task for you, you are to help Richard's mercenaries. The vice-captain, Tan, doesn't trust you, but Tris has told him to show you the way. Talk to <NAVI>[Tan]<INFO>jor_mbase,57,150,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Tan"
	},
	[23243] = {
		Title = "The Georborg Resistance",
		IconName = "ico_ep.bmp",
		Description = { "Tan made it clear he doesn't trust you: if you last through the mercenaries' training, he may think again. Head for <NAVI>[Richard's mercenaries]<INFO>jor_mbase,313,106,0,101,0</INFO></NAVI> in Lunaforma." },
		Summary = "Talk to Richard"
	},
	[23244] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "You told Tris how it went with the mercenaries. Nillem has been sent to Alberta and Lehar to the Wigner Company, and Tris has someone to introduce to you. Talk to <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI> again." },
		Summary = "Talk to Tris"
	},
	[23245] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "You were introduced to Heine, the wizard of Comodo, and to her newest invention: Heine's Tablet. Tell <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI> when you are ready for a new task." },
		Summary = "Talk to Tris"
	},
	[23246] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "Heine wants you to gather Bright Eyes around Lunaforma yourself. From Tris's face, this was a sudden whim of hers. Hear the rest from <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Tris"
	},
	[23247] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "Heine notices at once when something isn't done exactly as she said. Defeat 10 Skipskippers on the Raised Land, collect 1 Bright Eye, and report to <NAVI>[Tris]<INFO>jor_mbase,168,200,0,101,0</INFO></NAVI>." },
		Summary = "1 Bright Eye"
	},
	[23248] = {
		Title = "Profit and Loss",
		IconName = "ico_ep.bmp",
		Description = { "Meanwhile Heine asked Tris to send you to Alberta. Join <NAVI>[Nillem]<INFO>jor_albe,192,209,0,101,0</INFO></NAVI> there." },
		Summary = "To Alberta"
	},
	[23249] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "Back at the barracks of Lunaforma, Heine's Tablet broke down in the middle of a call. <NAVI>[Tris]<INFO>mbase_in,92,123,0,101,0</INFO></NAVI> suggests waiting until Heine calls back." },
		Summary = "Talk to Tris"
	},
	[23250] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "The tablet reconnected, but Heine says it needs an overhaul and has named you her repair assistant. Tris lent you a <NAVI>[private room]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI> in the barracks." },
		Summary = "To the private room"
	},
	[23251] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "A remote repair never works on the first try, Heine says, so bring plenty of parts: 2 Vellelopy, from the Velellings of the Raised Land. Then return to <NAVI>[Heine]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI>." },
		Summary = "2 Vellelopy"
	},
	[23252] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "Heine has started the repair. Stay in the <NAVI>[private room]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI> and assist her." },
		Summary = "Help with the repair"
	},
	[23253] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "The first attempt failed. Stay in the <NAVI>[private room]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI> and assist her once more." },
		Summary = "Help with the repair"
	},
	[23254] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "The tablet works, but Heine had another reason to pick you. You told her why you came from the future. Tell <NAVI>[Tris]<INFO>mbase_in,92,123,0,101,0</INFO></NAVI> the news." },
		Summary = "Talk to Tris"
	},
	[23255] = {
		Title = "The Black-Haired Beast",
		IconName = "ico_ep.bmp",
		Description = { "With what Leon found and the news you brought from the future, the Georborg resistance decided to prepare the all-out war that will end the fight with the Jormungandr cult. Then there is a loud noise outside. Go <NAVI>[outside]<INFO>jor_mbase,201,192,0,101,0</INFO></NAVI> and see." },
		Summary = "Go outside"
	},
	[23256] = {
		Title = "Never Credited",
		IconName = "ico_ep.bmp",
		Description = { "Heine feels strange mana nearby and wants to measure it beyond Comodo: bring 3 Bright Eyes, from the Skipskippers, to <NAVI>[Heine]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI> in the private room of the barracks." },
		Summary = "3 Bright Eyes"
	},
	[23257] = {
		Title = "[Standby] Never Credited",
		IconName = "ico_dq.bmp",
		Description = { "Heine will start measuring once there is enough data. Visit <NAVI>[Heine]<INFO>mbase_in,21,168,0,101,0</INFO></NAVI> again tomorrow." },
		Summary = "Reset at 04:00"
	},
	[23271] = {
		Title = "The Doctor's Truth",
		IconName = "ico_ep.bmp",
		Description = { "Neumann, who worked as a doctor in Geffen, was a fake doctor. Why did he do it? Go back to Geffen and talk it over with <NAVI>[Maxim]<INFO>ch1_gef_in,172,187,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Maxim"
	},
	[23272] = {
		Title = "What Kind of Man Is the Doctor? 1",
		IconName = "ico_ep.bmp",
		Description = { "Maxim rarely stays in Geffen and doesn't know the doctor well. Ask the <NAVI>[Geffen residents]<INFO>ch1_geffen,183,161,0,101,0</INFO></NAVI> about Neumann." },
		Summary = "Ask a resident"
	},
	[23273] = {
		Title = "What Kind of Man Is the Doctor? 2",
		IconName = "ico_ep.bmp",
		Description = { "Maxim rarely stays in Geffen and doesn't know the doctor well. Ask the <NAVI>[Geffen residents]<INFO>ch1_geffen,61,92,0,101,0</INFO></NAVI> about Neumann." },
		Summary = "Ask a resident"
	},
	[23274] = {
		Title = "What Kind of Man Is the Doctor? 3",
		IconName = "ico_ep.bmp",
		Description = { "Maxim rarely stays in Geffen and doesn't know the doctor well. Ask the <NAVI>[Geffen residents]<INFO>ch1_geffen,129,197,0,101,0</INFO></NAVI> about Neumann." },
		Summary = "Ask a resident"
	},
	[23275] = {
		Title = "The Doctor's Truth",
		IconName = "ico_ep.bmp",
		Description = { "The residents of Geffen didn't really know what kind of man Neumann was either. Go back to <NAVI>[Maxim]<INFO>ch1_gef_in,172,187,0,101,0</INFO></NAVI> and tell him." },
		Summary = "Talk to Maxim"
	},
	[23276] = {
		Title = "The Sick Go to the Doctor, the Doctor to the Nurse",
		IconName = "ico_ep.bmp",
		Description = { "Maxim thinks Neumann's wife Margot would know more about him, and told me where the nurse's sickroom is. Let's visit <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI>." },
		Summary = "Talk to the nurse"
	},
	[23277] = {
		Title = "The Sick Go to the Doctor, the Doctor to the Nurse",
		IconName = "ico_ep.bmp",
		Description = { "The nurse staying in the doctor's house doesn't seem to welcome questions about him. Ask <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI> about the doctor once more." },
		Summary = "Talk to the nurse"
	},
	[23278] = {
		Title = "The Sick Go to the Doctor, the Doctor to the Nurse",
		IconName = "ico_ep.bmp",
		Description = { "I asked about the doctor, but the nurse still won't talk. There must be a reason she avoids it... Ask <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI> again." },
		Summary = "Talk to the nurse"
	},
	[23279] = {
		Title = "The Sick Go to the Doctor, the Doctor to the Nurse",
		IconName = "ico_ep.bmp",
		Description = { "When I asked again, <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI> snapped at me. Let's ask just one last time..." },
		Summary = "Talk to the nurse"
	},
	[23280] = {
		Title = "Chronicle of a Doctor and a Nurse",
		IconName = "ico_ep.bmp",
		Description = { "The nurse began telling me about the doctor, but her throat hurts from talking. Bring her a cup of <NAVI>[water]<INFO>ch1_gef_in,104,173,0,101,0</INFO></NAVI> to hear the rest." },
		Summary = "Fetch water"
	},
	[23281] = {
		Title = "Chronicle of a Doctor and a Nurse",
		IconName = "ico_ep.bmp",
		Description = { "I've got water at just the right temperature. Bring it to <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI> and hear the rest about Dr. Neumann." },
		Summary = "Talk to the nurse"
	},
	[23282] = {
		Title = "Chronicle of a Doctor and a Nurse",
		IconName = "ico_ep.bmp",
		Description = { "<NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI> told me how she and Neumann, a nurse and a doctor, found out they were both refugees. Wait while she rests, then hear the rest." },
		Summary = "Talk to the nurse"
	},
	[23283] = {
		Title = "Chronicle of a Doctor and a Nurse",
		IconName = "ico_ep.bmp",
		Description = { "Margot stopped as if she couldn't remember. Find Neumann's records hidden under the mattress of the bed downstairs in the doctor's house and bring them to <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI>." },
		Summary = "Find Neumann's records"
	},
	[23284] = {
		Title = "Chronicle of a Doctor and a Nurse",
		IconName = "ico_ep.bmp",
		Description = { "I found Neumann's records. They might bring back Margot's memories. Go back to <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI>." },
		Summary = "Talk to the nurse"
	},
	[23285] = {
		Title = "Hope for a Cure",
		IconName = "ico_ep.bmp",
		Description = { "The nurse confessed that Neumann used other infected people as test subjects to save her, and offered her own blood for the research. Take the news to the <NAVI>[researchers]<INFO>ygg_fruit,103,73,0,101,0</INFO></NAVI> of Ash Village." },
		Summary = "To Ash Village"
	},
	[23286] = {
		Title = "Hope for a Cure",
		IconName = "ico_ep.bmp",
		Description = { "Assistant Bailey thinks the nurse's blood could help, and will come to Geffen to draw it. Go back to <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI> in Geffen." },
		Summary = "Talk to the nurse"
	},
	[23287] = {
		Title = "Hope for a Cure",
		IconName = "ico_ep.bmp",
		Description = { "The nurse's blood was drawn safely. Assistant Bailey seems to want a word. Talk to <NAVI>[Bailey]<INFO>ch1_gef_in,140,164,0,101,0</INFO></NAVI> in Geffen." },
		Summary = "Talk to Bailey"
	},
	[23288] = {
		Title = "Hope for a Cure",
		IconName = "ico_ep.bmp",
		Description = { "Bailey wants to watch over Margot and help in Geffen before going back to Ash Village, and asked me to deliver the blood while it's fresh. Go back to Ash Village and put it on <NAVI>[Bailey's shelf]<INFO>ygg_fruit,103,73,0,101,0</INFO></NAVI>." },
		Summary = "To Ash Village"
	},
	[23289] = {
		Title = "The Cure Is Made",
		IconName = "ico_ep.bmp",
		Description = { "I have the special Hal. Bring it back to <NAVI>[Ash Village]<INFO>ygg_fruit,103,73,0,101,0</INFO></NAVI> for the cure research." },
		Summary = "To Ash Village"
	},
	[23290] = {
		Title = "The Cure Is Made",
		IconName = "ico_ep.bmp",
		Description = { "Assistant Bailey made the cure with the special Hal and asked me to take it to Geffen. Talk to <NAVI>[Maxim]<INFO>ch1_gef_in,172,187,0,101,0</INFO></NAVI> in Geffen about handing it out." },
		Summary = "Talk to Maxim"
	},
	[23291] = {
		Title = "The Cure Is Made",
		IconName = "ico_ep.bmp",
		Description = { "Maxim thinks a trial is better than using the cure right away. Give it first to <NAVI>[Margot]<INFO>ch1_gef_in,138,162,0,101,0</INFO></NAVI>, whose symptoms are the worst." },
		Summary = "Talk to the nurse"
	},
	[23292] = {
		Title = "The Cure Is Made",
		IconName = "ico_ep.bmp",
		Description = { "I gave the nurse the cure. We'll have to wait to see how it goes. <NAVI>[Maxim]<INFO>ch1_gef_in,136,164,0,101,0</INFO></NAVI> seems to have something to say." },
		Summary = "Talk to Maxim"
	},
	[23293] = {
		Title = "The Cure Is Made",
		IconName = "ico_ep.bmp",
		Description = { "Maxim will look after Margot while the cure works. For a closer watch, bring him the <NAVI>[journal]<INFO>ch1_gef_in,175,186,0,101,0</INFO></NAVI> he has kept on her illness." },
		Summary = "Find Maxim's journal"
	},
	[23294] = {
		Title = "The Cure Is Made",
		IconName = "ico_ep.bmp",
		Description = { "I found the journal where Maxim recorded Margot's illness. Go back to <NAVI>[Maxim]<INFO>ch1_gef_in,136,164,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Maxim"
	},
	[23295] = {
		Title = "Handing Out the Cure 1",
		IconName = "ico_ep.bmp",
		Description = { "Margot is getting better, so the cure works. Give it to the <NAVI>[villagers]<INFO>ch1_gef_in,61,76,0,101,0</INFO></NAVI> at Geffen's clinic." },
		Summary = "Give the cure"
	},
	[23296] = {
		Title = "Handing Out the Cure 2",
		IconName = "ico_ep.bmp",
		Description = { "Margot is getting better, so the cure works. Give it to the <NAVI>[villagers]<INFO>ch1_gef_in,108,35,0,101,0</INFO></NAVI> at Geffen's clinic." },
		Summary = "Give the cure"
	},
	[23297] = {
		Title = "Handing Out the Cure 3",
		IconName = "ico_ep.bmp",
		Description = { "Margot is getting better, so the cure works. Give it to the <NAVI>[villagers]<INFO>ch1_gef_in,110,102,0,101,0</INFO></NAVI> at Geffen's clinic." },
		Summary = "Give the cure"
	},
	[23298] = {
		Title = "The Cure Is Made",
		IconName = "ico_ep.bmp",
		Description = { "I gave the cure to the people at the clinic. Go back to <NAVI>[Maxim]<INFO>ch1_gef_in,172,187,0,101,0</INFO></NAVI> in Geffen and report." },
		Summary = "Talk to Maxim"
	},
	[23299] = {
		Title = "The Cure Is Made",
		IconName = "ico_ep.bmp",
		Description = { "Maxim seems to have something more to tell me. Talk to <NAVI>[Maxim]<INFO>ch1_gef_in,172,187,0,101,0</INFO></NAVI> in Geffen again." },
		Summary = "Talk to Maxim"
	},
	[24000] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Tan still doesn't trust you. Go to the <NAVI>[mercenaries' office]<INFO>mbase_in,289,124,0,101,0</INFO></NAVI> in south-east Lunaforma and meet Richard." },
		Summary = "Go to the mercenaries' office"
	},
	[24001] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "The office was empty, until a <NAVI>[man]<INFO>mbase_in,292,127,0,101,0</INFO></NAVI> walked in. Ask him where Richard is." },
		Summary = "Talk to the man in the office"
	},
	[24002] = {
		Title = "Richard's Mercenaries",
		IconName = "ico_ep.bmp",
		Description = { "Richard might be in his room. Go to <NAVI>[Richard's room]<INFO>mbase_in,113,120,0,101,0</INFO></NAVI> in the central barracks of Lunaforma." },
		Summary = "To Richard's room"
	},
	[24003] = {
		Title = "Richard's Mercenaries",
