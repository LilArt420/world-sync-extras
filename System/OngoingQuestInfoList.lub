	[12588] = {
		Title = "[Standby] The Immortal",
		IconName = "ico_dq.bmp",
		Description = { "After dawn, you can communicate with <NAVI>The Branch of the World Tree<INFO>jor_twig,113,146,0,101,0</INFO></NAVI> again." },
		Summary = "Resets at 4 AM"
	},
	[12590] = {
		Title = "The Story of the Immortal",
		IconName = "ico_ep.bmp",
		Description = { "Is it impossible to kill Rasgand? Then what should we do? Is there no way?" },
		Summary = "EP20 MD"
	},
	[12591] = {
		Title = "Neutralizing the Immortal",
		IconName = "ico_ep.bmp",
		Description = { "It's said that killing Rasgand is impossible, but it seems like we can somehow make him powerless for a while." },
		Summary = "Neutralizing Rasgand"
	},
	[12647] = {
		Title = "Memory Repetition",
		IconName = "ico_dq.bmp",
		Description = { "It seems the time of the final battle repeats itself, slightly changing every day. If I return the next day, the same day will repeat itself. Let's witness the final battle again in the cult's temple, in an unknown location hidden behind a <NAVI>[decorative door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI>." },
		Summary = "Resets at 4 AM"
	},
	[12656] = {
		Title = "Final Battle",
		IconName = "ico_dq.bmp",
		Description = { "We cannot even begin to imagine what battle awaits us beyond the gloomy, massive gate before us. Let us go and witness the battle for humanity's survival. Let's witness the final battle again in the cult's temple, in an unknown location hidden behind a <NAVI>[decorative door]<INFO>jor_raise1,128,326,0,101,0</INFO></NAVI>." },
		Summary = "A Hand in the Flow of History"
	},
	[12660] = {
		Title = "The Wizard Professor's Call",
		IconName = "ico_ep.bmp",
		Description = { "The Wizard Professor has something to say about the Dark Whisper, so let's head to the <NAVI>[former entrance]<INFO>hem_dun01,208,246,0,101,0</INFO></NAVI> to the Sky Fortress." },
		Summary = "The Dark Whisper's Reappearance"
	},
	[12661] = {
		Title = "[Standby] Enter the recreated Dark Whisper",
		IconName = "ico_ep.bmp",
		Description = { "According to the professor, the energy required to recreate the Dark Whisper is limited to once every three days. Let's try again in three days." },
		Summary = "Resets after 3 days"
	},
	[12662] = {
		Title = "Finding Clues",
		IconName = "ico_ep.bmp",
		Description = { "Who is the powerful being that snatched Himmelmez away immediately after defeating her? To uncover even the smallest clues, we need to replay the battle over and over again." },
		Summary = "Defeating the Immortal Lord"
	},
	[12663] = {
		Title = "Destroy the Sky Fortress",
		IconName = "ico_ep.bmp",
		Description = { "We must destroy Dark Whisper, the source of the infection. Go to the <NAVI>[Sky Fortress Entrance]<INFO>hem_dun01,208,246,0,101,0</INFO></NAVI> and find a collaborator." },
		Summary = "Infiltrate the Sky Fortress"
	},
	[12664] = {
		Title = "Battle of Dark Whisper",
		IconName = "ico_ep.bmp",
		Description = { "To conquer the Dark Whisper completely, Himmelmez must be defeated. If you fell out of line, rejoin <NAVI>[Est]<INFO>hem_dun01,209,248,0,101,0</INFO></NAVI> at the Sky Fortress Entrance." },
		Summary = "Defeat the Immortal Lord"
	},
	[12665] = {
		Title = "Return to the Village",
		IconName = "ico_ep.bmp",
		Description = { "We defeated Himmelmez, but the ending left a bitter aftertaste. Let's return to the <NAVI>[village]<INFO>ygg_edge,167,136,0,101,0</INFO></NAVI> and discuss this." },
		Summary = "A Questionable Ending"
	},
	[12666] = {
		Title = "Infiltrating the Disgusting Place",
		IconName = "ico_ep.bmp",
		Description = { "Talk to Est at the <NAVI>[Sky Fortress Entrance]<INFO>hem_dun01,208,246,0,101,0</INFO></NAVI> to infiltrate the Sky Fortress." },
		Summary = "Infiltrate the Sky Fortress"
	},
	[16667] = {
		Title = "Dungeon Food - First Reading",
		IconName = "ico_ep.bmp",
		Description = { "I started reading 'Dungeon Food' of the <NAVI>[Fantasy Book]<INFO>prt_elib,59,45,0,101,0</INFO></NAVI> for the first time. Read all and meet the Table of Contents Fairy Ink." },
		Summary = "Complete the first reading of the Fantasy Book"
	},
	[16668] = {
		Title = "[Cooldown] Dungeon Food",
		IconName = "ico_ep.bmp",
		Description = { "'Dungeon Food' of the <NAVI>[Fantasy Book]<INFO>prt_elib,59,45,0,101,0</INFO></NAVI> can only be read once a day. Let's wait a little longer." },
		Summary = "Reset at 04:00"
	},
	[16669] = {
		Title = "Dungeon Food - Ink in the Book",
