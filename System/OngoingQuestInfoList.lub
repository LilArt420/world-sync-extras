	},
	[17922] = {
		Title = "Clover's Worry",
		IconName = "ico_ep.bmp",
		Description = { "Clover keeps worrying about the people left in destroyed Verus. Let's ask <NAVI>[them]<INFO>hem_dun01,85,139,0,101,0</INFO></NAVI> what help they need." },
		Summary = "To destroyed Verus"
	},
	[17923] = {
		Title = "Clover's Worry",
		IconName = "ico_ep.bmp",
		Description = { "Told that the people tainted by madness are the problem, I'll ask <NAVI>[Jeon Cheosa]<INFO>ch1_geffen,117,117,0,101,0</INFO></NAVI> in Destroyed Geffen whether there's a solution." },
		Summary = "Talk to Jeon Cheosa"
	},
	[17924] = {
		Title = "Clover's Worry",
		IconName = "ico_ep.bmp",
		Description = { "Having heard <NAVI>[Sua]<INFO>hem_dun01,85,139,0,101,0</INFO></NAVI>'s troubles, Jeon Cheosa says he'll take his time looking around destroyed Verus for a solution." },
