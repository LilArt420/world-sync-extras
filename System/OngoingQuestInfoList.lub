		IconName = "ico_ep.bmp",
		Description = { "With clues to the plague in hand, the party goes to the town hall of Destroyed Geffen to meet the rest of the <NAVI>[party]<INFO>ch1_gef_in,173,186,0,101,0</INFO></NAVI>." },
