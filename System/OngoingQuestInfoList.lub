		IconName = "ico_ep.bmp",
		Description = { "Go to the <NAVI>[Request Manager]<INFO>ba_chess,25,13,0,101,0</INFO></NAVI> to receive information about the newly discovered Depths Abyss within the Varmundt Biosphere." },
