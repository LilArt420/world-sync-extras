	},
	[16689] = {
		Title = "Dungeon Food - The End of the Story",
		IconName = "ico_ep.bmp",
		Description = { "After dinner, it's time to wrap up the short story. Speak with <NAVI>[Seyren Windsor]<INFO>vr_bob,290,198,0,101,0</INFO></NAVI> to prepare to close the book." },
