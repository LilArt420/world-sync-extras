	},
	[64131] = {
		Title = "The Eroded Wing",
		IconName = "ico_ep.bmp",
		Description = { "A dimensional rift ate into the east wing of Varmundt's mansion. <NAVI>[Hongsi]<INFO>ba_void,140,101,0,101,0</INFO></NAVI> asks me to meet the four watchers of its doors: Geonsi, Banshi, Yeonsi and Cheongsi, then report back." },
		Summary = "Meet the four watchers"
	},
	[64201] = {
		Title = "Crossroads of Tangled Magic",
		IconName = "ico_ep.bmp",
		Description = { "The ward a sage wove over the forest long ago has knotted itself up, and it's starting to hurt things. Loosen the three knots of magic in <NAVI>[Sanctuary Beledor]<INFO>veledor,149,312,0,101,0</INFO></NAVI>." },
		Summary = "Loosen 3 knots in Beledor"
	},
	[64202] = {
		Title = "Crossroads of Tangled Magic",
		IconName = "ico_ep.bmp",
		Description = { "El, the World Tree's guardian, woke when the knots came loose. Meet him and <NAVI>[Sasha]<INFO>ygg_fruit,80,122,0,101,0</INFO></NAVI> in the Tube Fruit house of Ash Village." },
		Summary = "Talk to Sasha"
	},
	[64203] = {
		Title = "News from the Burning Land",
		IconName = "ico_ep.bmp",
		Description = { "News came from the Harvans' village in Muspelheim: something cold. Find <NAVI>[Chez]<INFO>mu_fild01,110,166,0,101,0</INFO></NAVI>, who keeps watch in Volund Valley." },
		Summary = "Talk to Chez"
	},
	[64204] = {
		Title = "Between Cold Spot and Hot Spot",
		IconName = "ico_ep.bmp",
		Description = { "A cold spot in the land of fire, and Harvans missing. In Yongjirak, east of Volund Valley, talk to <NAVI>[Beryl]<INFO>kindlbrk,101,103,0,101,0</INFO></NAVI>, ask the four crafters what they saw and look at the white powder by the well." },
		Summary = "Ask around Yongjirak"
	},
	[64205] = {
		Title = "Between Cold Spot and Hot Spot",
		IconName = "ico_ep.bmp",
		Description = { "The missing Harvans went to the Root of Death. <NAVI>[Beryl]<INFO>kindlbrk,262,110,0,101,0</INFO></NAVI>'s boat at the east dock goes to its edge. Find out what's there." },
		Summary = "To the Root of Death"
	},
	[64206] = {
		Title = "What Was Met at the Root of Death",
		IconName = "ico_ep.bmp",
		Description = { "Gregor and Devries found Harvans frozen solid. Thaw the 3 frozen Harvans with Devries's warming draught, defeat 30 ice creatures at the Root of Death, and report to <NAVI>[Gregor]<INFO>deadroot,106,170,0,101,0</INFO></NAVI>." },
		Summary = "Thaw 3 Harvans, 30 monsters"
	},
	[64207] = {
		Title = "Sprout of the Ended World",
		IconName = "ico_ep.bmp",
		Description = { "A sprout grows out of the frozen lava at the Root of Death. It comes from a world that already ended. Show it to the Valkyrie Il in Brimir." },
		Summary = "Show the sprout to Il"
	},
	[64208] = {
		Title = "A Fragmented Other Root",
		IconName = "ico_ep.bmp",
		Description = { "Meet <NAVI>[Gregor]<INFO>uknw_ruin,273,237,0,101,0</INFO></NAVI> in Distorted Brimir and ask <NAVI>[Il]<INFO>uknw_ruin,272,235,0,101,0</INFO></NAVI> about the sprout." },
		Summary = "Talk to Il"
	},
	[64209] = {
		Title = "Residents of the Ragged Root",
		IconName = "ico_ep.bmp",
		Description = { "Il's branch led to Ragsruth, the Ragged Root of a world that ended. Devries says its people are the Folnirs; meet their leader, <NAVI>[Artea]<INFO>ragsruth,124,47,0,101,0</INFO></NAVI>." },
		Summary = "Talk to Artea"
	},
	[64210] = {
		Title = "Residents of the Ragged Root - Suspicious Movement",
		IconName = "ico_ep.bmp",
		Description = { "Something is moving in Distorted Ragsruth. Touch the old branch at its far end, search the grass piles for 3 traces, and report to <NAVI>[Artea]<INFO>ragsruth,124,47,0,101,0</INFO></NAVI>." },
		Summary = "Branch and 3 traces"
	},
	[64211] = {
		Title = "Nirhult",
		IconName = "ico_ep.bmp",
		Description = { "An intruder has come into Ragsruth: Nirhult. Drive him out, alone or with your party, and report to <NAVI>[Artea]<INFO>ragsruth,124,47,0,101,0</INFO></NAVI>." },
		Summary = "Defeat Nirhult"
	},
	[64212] = {
		Title = "Fragment of the End",
		IconName = "ico_ep.bmp",
		Description = { "Nirhult left a black, glittering fragment behind: a piece of whatever ended Ragsruth's world. Take it to <NAVI>[Sasha]<INFO>ygg_fruit,80,122,0,101,0</INFO></NAVI> and El in Ash Village." },
		Summary = "Talk to Sasha"
	},
	[64220] = {
		Title = "Time to Do What Must Be Done",
		IconName = "ico_ep.bmp",
		Description = { "Yongjirak is still getting back on its feet. Ask the four Harvans around the square what they need most, then report to <NAVI>[Tamarin]<INFO>kin_in01,34,251,0,101,0</INFO></NAVI>." },
