	[64001] = {
		Title = "Issgard Crafting Contest: Inventions",
		IconName = "ico_ep.bmp",
		Description = { "Only materials I gather myself count. Defeat 30 monsters in the Frozen Treasure Storage, make an invention with the <NAVI>[Crafting Simulator]<INFO>vr_zrr01,39,96,0,101,0</INFO></NAVI> and show it to <NAVI>[VR Vellgunde]<INFO>vr_zrr01,44,84,0,101,0</INFO></NAVI>. VR Lazy knows what she wants today." },
		Summary = "30 monsters in the Treasure Storage"
	},
	[64002] = {
		Title = "Issgard Crafting Contest: Cooking",
		IconName = "ico_ep.bmp",
		Description = { "Only ingredients I gather myself count. Defeat 30 monsters in the Frozen Food Storage, cook a dish with the <NAVI>[Cooking Simulator]<INFO>vr_zrr01,85,149,0,101,0</INFO></NAVI> and serve it to <NAVI>[VR Zoryara]<INFO>vr_zrr01,94,142,0,101,0</INFO></NAVI>. VR Toryoryo knows the family recipe." },
		Summary = "30 monsters in the Food Storage"
	},
	[64003] = {
		Title = "[Standby] Invention Judged",
		IconName = "ico_ep.bmp",
		Description = { "Vellgunde judged my invention. One entry a day: I can enter again after 4 AM." },
		Summary = "Reset at 04:00"
	},
	[64004] = {
